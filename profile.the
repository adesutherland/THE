/* THE Default Profile

   This profile is executed when THE starts up.
   It contains a few sensible defaults and key bindings.
*/

/* Bind F4 and Shift-Tab to move the cursor to the prefix area. */
/* This is particularly useful on macOS where the Home key can be tricky. */
'define f4 cursor prefix'
'define s-tab cursor home save'
'define backspace sos delback'

/* Load Parser */
'SET SDSLH tp /usr/local/bin/tp -s'
'SET AUTOCOLOR *.toy tp'
'SET COLORING ON AUTO'

/* Configure a modern dark view (VS Code Dark+ Inspired) */
'set color gap #6A9955 on #1E1E1E'
'set color cgap #6A9955 on #1E1E1E'
'set color arrow #569CD6 on #1E1E1E'
'set color filearea #D4D4D4 on #1E1E1E'
'set color curline #D4D4D4 on #2D2D30'
'set color cursorline #D4D4D4 on #2D2D30'
'set color prefix #858585 on #252526'
'set color cprefix #D4D4D4 on #007ACC'
'set color tofeof #569CD6 on #1E1E1E'
'set color ctofeof #569CD6 on #1E1E1E'
'set color cmdline #D4D4D4 on #2D2D30'
'set color msgline tomato on #1E1E1E'
'set color idline darkblue on dodgerblue'
'set color scale cadetblue on #1E1E1E'
'set color pending #CE9178 on #1E1E1E'
'set color shadow #858585 on #1E1E1E'
'set color statarea white on #007ACC'
'set prefix gap 1'

/* Display the parser message dynamically on the status line */
'set statopt off *'
'set statopt on pmsg.1 23 45 Msg='

/* Diagnostic token colors in the file area */
'set color cberror white on firebrick'
'set color cbwarn black on gold'
'set color cbinfo white on #007ACC'

/* Dynamic Status Line colors */
'set color pmsgerror white on firebrick'
'set color pmsgwarn black on gold'
'set color pmsginfo white on #007ACC'

/* Syntax Highlighting Colors (Modern Dark Theme) */
'set ecolor comment #6A9955 on #1E1E1E'
'set ecolor string #CE9178 on #1E1E1E'
'set ecolor incomplete_string #CE9178 on #1E1E1E'
'set ecolor keyword #569CD6 on #1E1E1E'
'set ecolor identifier #9CDCFE on #1E1E1E'
'set ecolor number #B5CEA8 on #1E1E1E'
'set ecolor operator #D4D4D4 on #1E1E1E'
'set ecolor paren #D4D4D4 on #1E1E1E'
'set ecolor level1_paren #D4D4D4 on #1E1E1E'
'set ecolor level2_paren #DCDCAA on #1E1E1E'
'set ecolor function #DCDCAA on #1E1E1E'

/* Display a startup message */
'msg Welcome to THE (The Hessling Editor) - CREXX Edition'
