options levelb
import rxfnsb
address the

efileid = .string[]
address the "extract /efileid/" expose efileid[]

source = efileid[1]
if source = "" then do
  'emsg CREXXCOMPILE no current file'
end
else do
  'save'
  command = 'crexx -noexec "' || source || '"'
  'msg ' || command
  'os ' || command
  if rc \= 0 then 'emsg CREXXCOMPILE rc ' || rc
end
