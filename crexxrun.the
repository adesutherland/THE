options levelb
import rxfnsb
address the

efileid = .string[]
address the "extract /efileid/" expose efileid[]

source = efileid[1]
if source = "" then do
  'emsg CREXXRUN no current file'
end
else do
  'save'
  command = 'crexx "' || source || '"'
  'msg ' || command
  'os ' || command
  if rc \= 0 then 'emsg CREXXRUN rc ' || rc
end
