/* Install the THE adaptation of Shmuel Metz's REXX prefix templates.
   Run with MACRO pfxsetup in a Regina build. */
address THE
'set compat xedit xedit xedit';
'set case mixed respect';
'set insertmode off';
'set prefix on left 8 0';
do i = 1 to words('DO IF SEL SELE SELEC SELECT WHEN RI RIC ..')
  name = word('DO IF SEL SELE SELEC SELECT WHEN RI RIC ..',i)
  'set prefix synonym' name 'pfxrexx';
  'set prefix synonym' translate(name,'abcdefghijklmnopqrstuvwxyz','ABCDEFGHIJKLMNOPQRSTUVWXYZ') 'pfxrexx';
end
'msg PFXREXX templates: DO IF SEL WHEN RI RIC ..';
