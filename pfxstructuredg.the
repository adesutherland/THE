/* THE's independently authored Level G structured-prefix implementation.
 * The behavior contract is tested against the patched Regina PFXREXX/PFXHLASM
 * workflows. This source does not invoke Regina or translate Classic source.
 */
options levelg
namespace the_prefix_g
import rxfnsb

prefixworkflow: class
  _kind = .string
  _name = .string
  _entered = .string
  _reason = .string
  _a = .string
  _b = .string
  _c = .string
  _source = .string
  _old = .string
  _mask = .string
  _pad = .string
  _pool = .standardaddresssandbox
  _line = .int
  _count = .int
  _indent = .int
  _opcol = .int
  _cline = .int
  _ccol = .int
  _saved = .int
  _new = .int

  *: factory
    arg kind = .string, request = .string
    _kind = kind
    _pool = .standardaddresssandbox()
    _entered = translate(word(request, 2))
    _name = _entered
    _reason = translate(word(request, 3))
    _line = word(request, 4) as .int
    _a = translate(word(request, 5))
    _b = translate(word(request, 6))
    _c = translate(word(request, 7))
    _count = 1
    _saved = 0
    return

  send: method = .int
    arg statement = .string
    address the statement;
    return rc

  restore: method = .void
    if _saved then do
      call send('command restore')
      _saved = 0
    end
    return

  fail: method = .int
    arg message = .string
    call restore()
    marker = _entered || ' ' || _a
    if _count <> 1 | datatype(_a, 'W') then marker = (_count as .string) || marker
    marker = left(marker || ' ' || _b || ' ' || _c, 6)
    call send('command :' || _line || ' set pending error ' || marker)
    call send('emsg ' || message || ': ' || _count || ' ' || _a || ' ' || _b || ' ' || _c)
    return 1

  mask: method = .void
    if _opcol = 0 then return
    if _kind = 'REXX' then do
      _mask = overlay('/*', '_', 40)
      _mask = overlay('*/', _mask, 70)
      _mask = overlay('.', _mask, _opcol)
    end
    else do
      _mask = overlay('*', _mask, 41)
      _mask = overlay('.', _mask, _opcol)
      _mask = overlay(',', _mask, _opcol + 8)
      call send('command set mask immed ' || _mask)
    end
    return

  record: method = .void
    arg text = .string, pending = .string
    if text = '' then call send('command add 1')
    else call send('command input ' || text)
    if pending <> '' then call send('command set pending on ' || pending)
    if _kind = 'REXX' & text = '' then do
      call send('command clocate :1')
      call send('command coverlay ' || _mask)
    end
    return

  canonical: method = .void
    if _kind = 'REXX' then do
      select
        when _name = '..' | _name = 'CLINE' then _name = 'CLEAN'
        when _name = 'CLC' | abbrev('CLOWE', _name) then _name = 'LOWER'
        when _name = 'CUC' | abbrev('CUPPE', _name) then _name = 'UPPER'
        when abbrev('SELECT', _name, 3) then _name = 'SELECT'
        when abbrev('OTHERWISE', _name, 4) then _name = 'OTHERWISE'
        when abbrev('WHEN', _name, 3) then _name = 'WHEN'
        otherwise nop
      end
    end
    else do
      select
        when _name = '..' then _name = 'CLEAN'
        when abbrev('ASMLEAVE', _name, 4) then _name = 'ASMLEAVE'
        when wordpos(_name, 'CASEE CASEN') > 0 then _name = 'CASENTRY'
        when abbrev('DOEXIT', _name, 4) then _name = 'DOEXIT'
        when _name = 'ELSEI' then _name = 'ELSEIF'
        when _name = 'EXITI' then _name = 'EXITIF'
        when _name = 'ITERA' then _name = 'ITERATE'
        when _name = 'ORELS' then _name = 'ORELSE'
        when wordpos(_name, 'OTHER OTHRW') > 0 then _name = 'OTHRWISE'
        when abbrev('SEARCH', _name, 3) | _name = 'STRTS' then _name = 'SEARCH'
        when abbrev('SELECT', _name, 3) then _name = 'SELECT'
        when abbrev('STAR', _name, 3) then _name = 'STAR'
        when abbrev('UNSTAR', _name, 4) then _name = 'UNSTAR'
        when _name = 'LC' then _name = 'LOWER'
        when _name = 'UC' then _name = 'UPPER'
        otherwise nop
      end
    end
    return

  indentation: method = .void
    _old = translate(word(_source, 1))
    _opcol = wordindex(_source, 1)
    if _kind = 'REXX' then do
      colon = pos(':', _old)
      if _old = '' then _opcol = 1
      else if colon > 0 then do
        after_label = substr(_old, colon + 1)
        if after_label = '' then _opcol = _opcol + 3
        else do
          _opcol = verify(_source, ' ', 'N', _opcol + colon)
          _old = strip(after_label)
        end
      end
      _indent = _opcol - 1
      select
        when _old = 'DO' then _indent = _indent + 3
        when wordpos(_old, 'ELSE IF') > 0 then _indent = _indent + 3
        when wordpos(_old, 'OTHERWISE WHEN') > 0 then do
          if wordpos(_name, 'WHEN OTHERWISE') = 0 then _indent = _indent + 2
        end
        when _old = 'SELECT' then _indent = _indent + 1
        otherwise do
          if _name = 'WHEN' then _indent = _indent - 2
        end
      end
    end
    else do
      if left(_source, 1) = '*' | left(_source, 2) = '.*' | _source = '' then do
        _old = ''
        _opcol = 10
      end
      else if left(_source, 1) = ' ' then do
        _old = translate(word(_source, 1))
        _opcol = wordindex(_source, 1)
      end
      else do
        _old = translate(word(_source, 2))
        _opcol = wordindex(_source, 2)
      end
      if _opcol = 0 then _opcol = 10
      _indent = _opcol - 1
      select
        when wordpos(_old, 'CASE CASENTRY DO ELSE ELSEIF IF STRTSRCH EXITIF ORELSE ENDLOOP SELECT') > 0 then _indent = _indent + 2
        when wordpos(_old, 'OTHRWISE WHEN') > 0 then do
          if wordpos(_name, 'WHEN OTHRWISE') = 0 then _indent = _indent + 2
        end
        otherwise do
          if wordpos(_name, 'CASE ELSEIF EXITIF WHEN') > 0 then _indent = _indent - 2
        end
      end
    end
    _indent = max(0, _indent)
    _opcol = _indent + 1
    _pad = copies(' ', _indent)
    return

  rexx_template: method = .int
    inner = _pad || '   '
    select
      when _name = 'DO' then do
        _opcol = _ccol + 3
        call mask()
        header = 'do'
        if _a = '' then _cline = _cline + 1
        else if abbrev('FOREVER', _a, 1) then do
          header = 'do while 1'
          _cline = _cline + 1
        end
        else if abbrev('UNTIL', _a) then do
          header = 'do until .'
          _ccol = _ccol + 9
        end
        else if abbrev('WHILE', _a) then do
          header = 'do while .'
          _ccol = _ccol + 9
        end
        else do
          header = 'do ' || _a
          _ccol = _ccol + 3
        end
        call record(_pad || header, 'CLINE')
        call record('', 'RI')
        call record(inner || 'end', '')
      end
      when _name = 'IF' then do
        _opcol = _ccol + 3
        call mask()
        call record(_pad || 'if . then do', 'CLINE')
        call record('', 'RI')
        call record(inner || 'end', '')
        call record(_pad || 'else do', '')
        call record('', 'RI')
        call record(inner || 'end', '')
      end
      when _name = 'SELECT' then do
        _cline = _cline + 1
        _ccol = _indent + 7
        _opcol = _indent + 4
        call mask()
        call record(_pad || 'select', '')
        call record(_pad || ' when . then do', 'CLINE')
        call record('', 'RIC')
        call record(_pad || '  end', '')
        call record(_pad || ' otherwise do', '')
        call record('', 'RI')
        call record(_pad || '  end', '')
        call record(_pad || ' end', '')
      end
      when _name = 'WHEN' | _name = 'OTHERWISE' then do
        _opcol = _indent + 3
        call mask()
        if _name = 'WHEN' then _ccol = _indent + 6
        else _cline = _cline + 1
        header = 'when . then do'
        if _name = 'OTHERWISE' then header = 'otherwise do'
        call record(_pad || header, '')
        call record('', 'RIC')
        call record(_pad || '  end', '')
      end
      otherwise return fail('Unknown prefix subcommand')
    end
    return 0

  asm_template: method = .int
    inner = _pad || '  '
    if wordpos(_name, 'DO IF SEARCH EXITIF WHEN SELECT') > 0 then _opcol = _ccol + 2
    else _opcol = _ccol
    if wordpos(_name, 'ENDIF ITERATE ORELSE OTHRWISE SELECT') = 0 then call mask()
    select
      when _name = 'DO' then do
        header = 'DO'
        select
          when abbrev('ONCE', _a) then do
            header = 'DO ONCE'
            _cline = _cline + 1
            _ccol = _opcol
          end
          when datatype(_a, 'W') then do
            header = 'DO FROM=(R' || _a || ')'
            _cline = _cline + 1
            _ccol = _opcol
          end
          when abbrev('BY', _a) then do
            operand = _b
            if operand = '' then operand = 'R?'
            else if datatype(operand, 'W') then operand = 'R' || operand
            header = 'DO FROM=(R?),BY=(' || operand || ')'
            _ccol = _ccol + 10
          end
          when abbrev('FOREVER', _a, 2) | abbrev('INF', _a) then do
            header = 'DO INF'
            _cline = _cline + 1
            _ccol = _opcol
          end
          when abbrev('FROM', _a, 2) then do
            header = 'DO FROM=(R?)'
            _ccol = _ccol + 10
          end
          when abbrev('UNTIL', _a) then do
            header = 'DO UNTIL=if_option'
            _ccol = _ccol + 8
          end
          when abbrev('WHILE', _a) then do
            header = 'DO WHILE=if_option'
            _ccol = _ccol + 8
          end
          otherwise header = 'DO ' || _a
        end
        call record(_pad || header, '..')
        call record(inner || 'opcod ,', 'RI')
        call record(_pad || 'ENDDO ,', '')
      end
      when _name = 'IF' then do
        header = 'IF .'
        if _a = '' then _ccol = _ccol + 3
        else if datatype(_a, 'W') | wordpos(_a, 'E EQ GT H L LE LT M N NE NH NL NM NO NP NZ O Z') > 0 then do
          header = 'IF (' || _a || ')'
          _cline = _cline + 1
          _ccol = _ccol + 2
        end
        else if _a = 'CC' then do
          header = 'IF CC=.'
          _ccol = _ccol + 6
        end
        else return fail('Invalid option for IF')
        call record(_pad || header, '..')
        call record(inner || 'opcod ,', 'RI')
        call record(_pad || 'ELSEIF .', '..')
        call record(inner || 'opcod ,', 'RI')
        call record(_pad || 'ELSE  ,', '..')
        call record(inner || 'opcod ,', 'RI')
        call record(_pad || 'ENDIF  ,', '')
      end
      when _name = 'SELECT' then do
        _cline = _cline + 1
        _ccol = _indent + 8
        _opcol = _indent + 5
        call mask()
        call record(_pad || 'SELECT ,', '')
        call record(inner || 'WHEN if_test', '..')
        call record(inner || '  opcod ,', 'RIC')
        call record(inner || 'OTHRWISE ,', '')
        call record(inner || '  opcod ,', 'RIC')
        call record(_pad || 'ENDSEL', '')
      end
      when _name = 'SEARCH' | _name = 'EXITIF' then do
        if _name = 'SEARCH' then do
          call record(_pad || 'STRTSRCH do_options', '..')
          call record(inner || 'opcod ,', 'RI')
        end
        call record(_pad || 'EXITIF if_options', '..')
        call record(inner || 'opcod ,', 'RI')
        call record(_pad || 'ORELSE  ,', '..')
        call record(inner || 'opcod ,', 'RI')
        if _name = 'SEARCH' then do
          call record(_pad || 'ENDLOOP ,', '..')
          call record(inner || 'opcod ,', 'RI')
          call record(_pad || 'ENDSRCH  ,', '')
          _ccol = _ccol + 9
        end
        else _ccol = _ccol + 7
      end
      when _name = 'CASENTRY' then do
        _ccol = _ccol + 5
        call record(_pad || 'CASENTRY R?,POWER=?,VECTOR=B', '')
        call record(inner || 'CASE ?', '..')
        call record(inner || '  opcod ,', 'RI')
        call record(_pad || 'ENDCASE ,', '')
      end
      when _name = 'CASE' | _name = 'ELSE' | _name = 'ELSEIF' | _name = 'WHEN' then do
        header = _name || ' ,'
        select
          when _name = 'CASE' then do
            header = 'CASE ?'
            _ccol = _ccol + 5
          end
          when _name = 'ELSEIF' then do
            header = 'ELSEIF test'
            _ccol = _ccol + 7
          end
          when _name = 'WHEN' then do
            header = 'WHEN if_test'
            _ccol = _indent + 6
          end
          otherwise nop
        end
        pending = '..'
        if _name = 'ELSE' | _name = 'ELSEIF' then pending = ''
        call record(_pad || header, pending)
        if _name = 'WHEN' then call record(inner || 'opcod ,', 'RIC')
        else call record(inner || 'opcod ,', 'RI')
      end
      when _name = 'ENDIF' | _name = 'ITERATE' | _name = 'ORELSE' | _name = 'OTHRWISE' then do
        header = _name || ' ,'
        if _name = 'ITERATE' then header = 'ITERATE label'
        call record(_pad || header, '..')
        if _name = 'ORELSE' | _name = 'OTHRWISE' then do
          call record(inner || 'opcod ,', 'RI')
          _ccol = _indent + 3
          _cline = _line + 2
        end
        else if _name = 'ENDIF' then _ccol = 0
        else _ccol = _indent + 9
      end
      when _name = 'ASMLEAVE' | _name = 'DOEXIT' then do
        if _name = 'ASMLEAVE' then header = 'ASMLEAVE label'
        else header = 'DOEXIT test'
        call record(_pad || header, '..')
        call record('', 'RI')
        if _name = 'ASMLEAVE' then _ccol = _ccol + 9
      end
      otherwise return fail('Unknown prefix subcommand')
    end
    return 0

  run: method = .int
    if _reason = 'CLEAR' then return 0
    if wordpos(_reason, 'SET SHADOW') = 0 then return 1
    call send('command :' || _line || ' set pending off')
    call send('command preserve')
    _saved = 1
    call send('command set scope all')
    if datatype(_a, 'W') then do
      _count = _a as .int
      _a = _b
      _b = _c
      _c = ''
    end
    else if datatype(left(_a, 1), 'W') then do
      _count = left(_a, 1) as .int
      _a = substr(_a, 2)
    end
    if _count < 1 | _count > 99 then return fail('Expected count from 1 to 99')
    call canonical()
    call send('command :' || _line)
    address the 'command extract /curline/cursor/zone/mask/line/column/flscreen/trunc/' sandbox _pool;
    _source = _pool.get('curline.3')
    if _kind = 'HLASM' then _source = left(_source, 71)
    _new = word(_pool.get('curline.5'), 1) = 'NEW'
    _mask = _pool.get('mask.1')
    call indentation()
    if _kind = 'HLASM' & _old = 'CASENTRY' then do
      if wordpos(_entered, '.. CASE LC RI RIC ST STA STAR UC UNST UNSTA') = 0 then return fail(_entered || ' not allowed between CASENTRY and first CASE')
    end
    _cline = _line + 1
    _ccol = _indent + 1
    if _name = 'UPPER' | _name = 'LOWER' then do
      command = 'uppercas'
      if _name = 'LOWER' then command = 'lowercas'
      if _a <> '' then do
        if _a = 'C' then limit = _pool.get('cursor.4') as .int
        else if datatype(_a, 'W') then limit = _a as .int
        else return fail('Invalid column designator')
        limit = min(limit, _pool.get('zone.2') as .int)
        if limit >= (_pool.get('zone.1') as .int) then call send('command set zone ' || _pool.get('zone.1') || ' ' || limit)
        else do
          call restore()
          return 0
        end
      end
      call send('command :' || _line || ' ' || command || ' ' || _count)
      call restore()
      return 0
    end
    do pass = 1 to _count
      _cline = _line + 1
      _ccol = _indent + 1
      call send('command :' || _line)
      select
        when _name = 'CLEAN' then do
          call mask()
          expected = _mask
          if _kind = 'REXX' then expected = translate(expected, ' ', '_')
          if _new & strip(_source, 'T') = strip(expected, 'T') then call send('command delete 1')
          _ccol = 0
          leave
        end
        when _name = 'RI' | _name = 'RIC' then do
          call mask()
          expected = _mask
          if _kind = 'REXX' then expected = translate(expected, ' ', '_')
          if _name = 'RIC' & _new & strip(_source, 'T') = strip(expected, 'T') then do
            call send('command delete 1')
            _ccol = 0
            leave
          end
          marker = '..'
          if _kind = 'REXX' then marker = 'CLINE'
          call send('command :' || _line || ' set pending on ' || marker)
          pending = marker
          if pass = 1 then pending = 'RIC' || _count
          call record('', pending)
        end
        when _name = 'STAR' | _name = 'UNSTAR' then do
          call send('command set trunc ' || max(_pool.get('trunc.1') as .int, 72))
          call send('command :' || (_line + pass - 1) || ' clocate :72')
          marker = '*'
          if _name = 'UNSTAR' then marker = '_'
          call send('command coverlay ' || marker)
          _ccol = 0
        end
        otherwise do
          if _kind = 'REXX' then code = rexx_template()
          else code = asm_template()
          if code <> 0 then return code
        end
      end
    end
    call restore()
    if _ccol > 0 then call send('command :' || _cline || ' cursor file ' || _cline || ' ' || _ccol || ' priority 30')
    call send('command refresh')
    return 0

main: procedure
  arg arguments = .string[]
  request = arguments[1]
  if translate(word(request, 1)) <> 'PREFIX' then do
    address the 'emsg Structured prefix macro must be invoked from the prefix area';
    exit 1
  end
  pool = .standardaddresssandbox()
  address the 'command editv get pfx_language' sandbox pool;
  kind = pool.get('pfx_language')
  if kind <> 'HLASM' then kind = 'REXX'
  workflow = .prefixworkflow
  workflow = .prefixworkflow(kind, request)
  result = workflow.run()
  exit result
