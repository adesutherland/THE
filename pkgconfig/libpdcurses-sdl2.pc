prefix=/home/mark/src/PDCursesMod
exec_prefix=${prefix}
libdir=${prefix}/sdl2
includedir=${prefix}
major_version=3
version=3.8

Name: pdcurses-sdl2w
Description: pdcurses 3.8 SDL2 library
Version: ${version}
URL: https://www.pdcurses.org
Requires.private:
Libs:  -L${libdir} -lpdcurses -lSDL2 -lSDL2_ttf
Libs.private:
Cflags:  -I${includedir}
