# pkg-config file generated by gen-pkgconfig
# vile:makemode

prefix=/home/mark/src/PDCursesMod
exec_prefix=${prefix}
libdir=${prefix}/x11
includedir=${prefix}
major_version=3
version=3.8

Name: pdcurses-x11w
Description: pdcurses 3.8 X11 library
Version: ${version}
URL: https://www.pdcurses.org
Requires.private:
Libs:  ${libdir}/libXCurses.a -lXaw -lXmu -lXt -lX11 -lXpm -lSM -lICE -lXext
Libs.private:
Cflags:  -DPDC_WIDE -DPDC_FORCE_UTF8 -DXCURSES -I${includedir} -I/usr/include/X11
