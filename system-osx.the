/* THE macOS UTF System Profile */
/* Executed before the user profile. */
/* Contains platform terminal calibration defaults. */
/* May be regenerated by utf_terminal_probe. */

options levelb
address the

/* Apple overrides are complete normal-display profile entries so platform */
/* policy is visible here rather than split across compiled fallback tables. */

'SET UTF TERMINAL CLASS combining DISPLAY normal OUTPUT native'
'SET UTF TERMINAL CLASS combining DISPLAY normal METRICS profile'
'SET UTF TERMINAL CLASS combining DISPLAY normal MARK none'
'SET UTF TERMINAL CLASS combining DISPLAY normal WIDTH 1 ADVANCE 1 CURSOR 1 REPAINT 1'
'SET UTF TERMINAL CLASS combining DISPLAY normal CURSORSTRATEGY cells'
'SET UTF TERMINAL CLASS combining DISPLAY normal REPLACESTRATEGY cells'

'SET UTF TERMINAL CLASS combining-stack DISPLAY normal OUTPUT native'
'SET UTF TERMINAL CLASS combining-stack DISPLAY normal METRICS profile'
'SET UTF TERMINAL CLASS combining-stack DISPLAY normal MARK none'
'SET UTF TERMINAL CLASS combining-stack DISPLAY normal WIDTH 1 ADVANCE 1 CURSOR 1 REPAINT 1'
'SET UTF TERMINAL CLASS combining-stack DISPLAY normal CURSORSTRATEGY cells'
'SET UTF TERMINAL CLASS combining-stack DISPLAY normal REPLACESTRATEGY cells'

'SET UTF TERMINAL CLASS wide DISPLAY normal OUTPUT native'
'SET UTF TERMINAL CLASS wide DISPLAY normal METRICS profile'
'SET UTF TERMINAL CLASS wide DISPLAY normal MARK none'
'SET UTF TERMINAL CLASS wide DISPLAY normal WIDTH 2 ADVANCE 2 CURSOR 2 REPAINT 2'
'SET UTF TERMINAL CLASS wide DISPLAY normal CURSORSTRATEGY cells'
'SET UTF TERMINAL CLASS wide DISPLAY normal REPLACESTRATEGY line'

'SET UTF TERMINAL CLASS emoji DISPLAY normal OUTPUT native'
'SET UTF TERMINAL CLASS emoji DISPLAY normal METRICS profile'
'SET UTF TERMINAL CLASS emoji DISPLAY normal MARK none'
'SET UTF TERMINAL CLASS emoji DISPLAY normal WIDTH 2 ADVANCE 2 CURSOR 2 REPAINT 2'
'SET UTF TERMINAL CLASS emoji DISPLAY normal CURSORSTRATEGY cells'
'SET UTF TERMINAL CLASS emoji DISPLAY normal REPLACESTRATEGY line'

'SET UTF TERMINAL CLASS text-variation DISPLAY normal OUTPUT native'
'SET UTF TERMINAL CLASS text-variation DISPLAY normal METRICS profile'
'SET UTF TERMINAL CLASS text-variation DISPLAY normal MARK none'
'SET UTF TERMINAL CLASS text-variation DISPLAY normal WIDTH 1 ADVANCE 1 CURSOR 1 REPAINT 1'
'SET UTF TERMINAL CLASS text-variation DISPLAY normal CURSORSTRATEGY cells'
'SET UTF TERMINAL CLASS text-variation DISPLAY normal REPLACESTRATEGY cells'

'SET UTF TERMINAL CLASS emoji-variation DISPLAY normal OUTPUT native'
'SET UTF TERMINAL CLASS emoji-variation DISPLAY normal METRICS profile'
'SET UTF TERMINAL CLASS emoji-variation DISPLAY normal MARK none'
'SET UTF TERMINAL CLASS emoji-variation DISPLAY normal WIDTH 2 ADVANCE 2 CURSOR 2 REPAINT 2'
'SET UTF TERMINAL CLASS emoji-variation DISPLAY normal CURSORSTRATEGY cells'
'SET UTF TERMINAL CLASS emoji-variation DISPLAY normal REPLACESTRATEGY line'

'SET UTF TERMINAL CLASS modifier DISPLAY normal OUTPUT native'
'SET UTF TERMINAL CLASS modifier DISPLAY normal METRICS profile'
'SET UTF TERMINAL CLASS modifier DISPLAY normal MARK none'
'SET UTF TERMINAL CLASS modifier DISPLAY normal WIDTH 2 ADVANCE 4 CURSOR 4 REPAINT 4'
'SET UTF TERMINAL CLASS modifier DISPLAY normal CURSORSTRATEGY cells'
'SET UTF TERMINAL CLASS modifier DISPLAY normal REPLACESTRATEGY line'

/* OUTPUT base is a general physical-display transform. */
/* Apple Terminal uses it here because native keycap glyphs have unreliable cursor/repaint behaviour. */
/* The stored file text remains the original keycap sequence. */
'SET UTF TERMINAL CLASS keycap DISPLAY normal OUTPUT base'
'SET UTF TERMINAL CLASS keycap DISPLAY normal METRICS profile'
'SET UTF TERMINAL CLASS keycap DISPLAY normal MARK compressed'
'SET UTF TERMINAL CLASS keycap DISPLAY normal WIDTH 1 ADVANCE 1 CURSOR 1 REPAINT 1'
'SET UTF TERMINAL CLASS keycap DISPLAY normal CURSORSTRATEGY cells'
'SET UTF TERMINAL CLASS keycap DISPLAY normal REPLACESTRATEGY cells'

'SET UTF TERMINAL CLASS regional-indicator DISPLAY normal OUTPUT native'
'SET UTF TERMINAL CLASS regional-indicator DISPLAY normal METRICS profile'
'SET UTF TERMINAL CLASS regional-indicator DISPLAY normal MARK none'
'SET UTF TERMINAL CLASS regional-indicator DISPLAY normal WIDTH 2 ADVANCE 2 CURSOR 2 REPAINT 2'
'SET UTF TERMINAL CLASS regional-indicator DISPLAY normal CURSORSTRATEGY cells'
'SET UTF TERMINAL CLASS regional-indicator DISPLAY normal REPLACESTRATEGY cells'

/* Apple Terminal keeps paired flags visibly native, but the cursor/repaint */
/* probe needs one extra physical cell after the two-cell glyph to avoid */
/* overlap with the following character. Keep this as a NORMAL profile rule. */
'SET UTF TERMINAL CLASS regional-flag DISPLAY normal OUTPUT native'
'SET UTF TERMINAL CLASS regional-flag DISPLAY normal METRICS profile'
'SET UTF TERMINAL CLASS regional-flag DISPLAY normal MARK none'
'SET UTF TERMINAL CLASS regional-flag DISPLAY normal WIDTH 2 ADVANCE 3 CURSOR 3 REPAINT 3'
'SET UTF TERMINAL CLASS regional-flag DISPLAY normal CURSORSTRATEGY cells'
'SET UTF TERMINAL CLASS regional-flag DISPLAY normal REPLACESTRATEGY cells'

/* Apple Terminal shapes these ZWJ clusters acceptably in NORMAL, but its */
/* physical grid behaves like adjacent visible components. Keep output */
/* native and make only the metric model a macOS profile choice. */
'SET UTF TERMINAL CLASS short-zwj DISPLAY normal OUTPUT native'
'SET UTF TERMINAL CLASS short-zwj DISPLAY normal METRICS expanded'
'SET UTF TERMINAL CLASS short-zwj DISPLAY normal MARK none'
'SET UTF TERMINAL CLASS short-zwj DISPLAY normal WIDTH 2 ADVANCE 2 CURSOR 2 REPAINT 2'
'SET UTF TERMINAL CLASS short-zwj DISPLAY normal CURSORSTRATEGY line'
'SET UTF TERMINAL CLASS short-zwj DISPLAY normal REPLACESTRATEGY line'

'SET UTF TERMINAL CLASS heart-zwj DISPLAY normal OUTPUT native'
'SET UTF TERMINAL CLASS heart-zwj DISPLAY normal METRICS expanded'
'SET UTF TERMINAL CLASS heart-zwj DISPLAY normal MARK none'
'SET UTF TERMINAL CLASS heart-zwj DISPLAY normal WIDTH 2 ADVANCE 2 CURSOR 2 REPAINT 2'
'SET UTF TERMINAL CLASS heart-zwj DISPLAY normal CURSORSTRATEGY line'
'SET UTF TERMINAL CLASS heart-zwj DISPLAY normal REPLACESTRATEGY line'

'SET UTF TERMINAL CLASS family-zwj DISPLAY normal OUTPUT native'
'SET UTF TERMINAL CLASS family-zwj DISPLAY normal METRICS expanded'
'SET UTF TERMINAL CLASS family-zwj DISPLAY normal MARK none'
'SET UTF TERMINAL CLASS family-zwj DISPLAY normal WIDTH 2 ADVANCE 2 CURSOR 2 REPAINT 2'
'SET UTF TERMINAL CLASS family-zwj DISPLAY normal CURSORSTRATEGY line'
'SET UTF TERMINAL CLASS family-zwj DISPLAY normal REPLACESTRATEGY line'

'SET UTF TERMINAL CLASS tag-flag DISPLAY normal OUTPUT native'
'SET UTF TERMINAL CLASS tag-flag DISPLAY normal METRICS profile'
'SET UTF TERMINAL CLASS tag-flag DISPLAY normal MARK none'
'SET UTF TERMINAL CLASS tag-flag DISPLAY normal WIDTH 2 ADVANCE 2 CURSOR 2 REPAINT 2'
'SET UTF TERMINAL CLASS tag-flag DISPLAY normal CURSORSTRATEGY cells'
'SET UTF TERMINAL CLASS tag-flag DISPLAY normal REPLACESTRATEGY line'

'SET UTF TERMINAL CLASS private-use DISPLAY normal OUTPUT native'
'SET UTF TERMINAL CLASS private-use DISPLAY normal METRICS profile'
'SET UTF TERMINAL CLASS private-use DISPLAY normal MARK none'
'SET UTF TERMINAL CLASS private-use DISPLAY normal WIDTH 1 ADVANCE 1 CURSOR 1 REPAINT 1'
'SET UTF TERMINAL CLASS private-use DISPLAY normal CURSORSTRATEGY cells'
'SET UTF TERMINAL CLASS private-use DISPLAY normal REPLACESTRATEGY cells'
