/* THE macOS UTF System Profile */
/* Executed before the user profile. */
/* Contains visible platform terminal calibration defaults. */

options levelb
address the

/* Apple Terminal has unreliable grid behaviour for sequence-shaped emoji. */
/* Keep safe classes native through the built-in defaults; sanitize only the */
/* classes that need a stable editing display on macOS. */

'SET UTF DISPLAY NORMAL CLASS modifier OUTPUT SANITIZE BASE METRICS OUTPUT MARK COMPRESSED WIDTH 2 ADVANCE 2 CURSOR 2 REPAINT 2 CURSORSTRATEGY CELLS REPLACESTRATEGY CELLS'

'SET UTF DISPLAY NORMAL CLASS keycap OUTPUT SANITIZE KEYCAP METRICS OUTPUT MARK COMPRESSED WIDTH 1 ADVANCE 1 CURSOR 1 REPAINT 1 CURSORSTRATEGY CELLS REPLACESTRATEGY CELLS'

'SET UTF DISPLAY NORMAL CLASS regional-flag OUTPUT SANITIZE REGION METRICS OUTPUT MARK COMPRESSED WIDTH 2 ADVANCE 2 CURSOR 2 REPAINT 2 CURSORSTRATEGY CELLS REPLACESTRATEGY CELLS'
'SET UTF DISPLAY DECOMPOSED CLASS regional-flag OUTPUT COMPONENTS METRICS COMPONENTS DISPLAYSTRATEGY ISOLATE CURSORSTRATEGY CELLS REPLACESTRATEGY CELLS'

'SET UTF DISPLAY NORMAL CLASS short-zwj OUTPUT SANITIZE COMPONENTS METRICS OUTPUT MARK COMPRESSED CURSORSTRATEGY CELLS REPLACESTRATEGY CELLS'
'SET UTF DISPLAY NORMAL CLASS heart-zwj OUTPUT SANITIZE COMPONENTS METRICS OUTPUT MARK COMPRESSED CURSORSTRATEGY CELLS REPLACESTRATEGY CELLS'
'SET UTF DISPLAY NORMAL CLASS family-zwj OUTPUT SANITIZE COMPONENTS METRICS OUTPUT MARK COMPRESSED CURSORSTRATEGY CELLS REPLACESTRATEGY CELLS'

'SET UTF DISPLAY NORMAL CLASS tag-flag OUTPUT SANITIZE DEFAULT METRICS OUTPUT MARK SUBSTITUTED WIDTH 1 ADVANCE 1 CURSOR 1 REPAINT 1 CURSORSTRATEGY CELLS REPLACESTRATEGY CELLS'
