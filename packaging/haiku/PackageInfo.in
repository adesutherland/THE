name        the_common
summary     "The Hessling Editor binary."
description "THE is a text editor based on the VM/CMS editor
XEDIT and many features of KEDIT written by Mansfield Software."
vendor      "Mark Hessling"
packager    "Mark Hessling <mark@rexx.org>"
architecture @MACH_ARCH@
version      @VERSION_UNQUOTED@-1
copyrights {
             "1991-2026 Mark Hessling"
           }
licenses   {
             "GNU GPL v2"
           }
urls       {
             "https://hessling-editor.sf.net/"
           }
source-urls {
             "https://hessling-editor.sf.net/downloads/the-@VERSION_UNQUOTED@.tar.gz"
           }
provides   {
             the_common = @VERSION_UNQUOTED@
             cmd:the = @VERSION_UNQUOTED@
           }
requires   {
             haiku>=r1~beta2_hrev54154_93-1
           }
