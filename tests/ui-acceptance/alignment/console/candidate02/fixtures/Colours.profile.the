'set footer COLOUR1 -9 AFTERCMDLINE';
'set reserved -8 green on black GREEN λ界';
'set footer COLOUR2 -8 AFTERCMDLINE';
'set reserved -7 cyan on black CYAN λ界';
'set footer COLOUR3 -7 AFTERCMDLINE';
'set reserved -6 red on black RED λ界';
'set footer COLOUR4 -6 AFTERCMDLINE';
'set reserved -5 magenta on black MAGENTA λ界';
'set footer COLOUR5 -5 AFTERCMDLINE';
'set reserved -4 yellow on black YELLOW λ界';
'set footer COLOUR6 -4 AFTERCMDLINE';
'set reserved -3 white on black WHITE λ界';
