# Contributor: Mark Hessling <mark@rexx.org>
# Maintainer: Mark Hessling <mark@rexx.org>
pkgname="the"
pkgver="4.0"
pkgrel=1
pkgdesc="The Hessling Editor"
url="https://www.rexx.org"
arch="x86_64"
license="GPL-2.0-or-later"
depends="regina-rexx"
makedepends="regina-rexx-dev"
subpackages="$pkgname-ncursesw_regina $pkgname-doc"
options="!check"
source="the-4.0.tar.gz"
builddir="$srcdir/"

build() {
        cd "$srcdir/$pkgname-$pkgver"
        ./configure \
           --build=$CBUILD \
           --host=$CHOST \
           --prefix=/usr \
           --sysconfdir=/etc \
           --mandir=/usr/share/man \
           --localstatedir=/var \
           --with-rexx=regina \
           --with-curses=ncursesw
        make -j1
}
ncursesw_regina() {
       mkdir -p "$subpkgdir"/usr/bin
       mv "$pkgdir"/usr/bin/the-conw  "$subpkgdir"/usr/bin/the-conw
}

package() {
        cd "$srcdir/$pkgname-$pkgver"
        make -j1 DESTDIR="$pkgdir" install
}
