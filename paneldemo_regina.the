/* Example: reserved fields and native Regina PULL results. */
address THE
'extract /cursor/'
savedline = cursor.3
savedcolumn = cursor.4
savedrow = cursor.1
savedcell = cursor.2
'extract /reserved */'
'preserve'
'set linend off'
'set curline off'
'set ctlchar ! escape'
'set ctlchar p protect white'
'set ctlchar u noprotect green'
'set reserved 2 !pName: !uGuest           !p  Enter submits; Esc cancels'
'set reserved 4 !pTopic: !uTHE panels      !p'
'read nochange tag'
readrc = rc
do while queued() > 0
   parse pull value
   'emsg PANEL_RESULT' value
end
'emsg PANEL_RC' readrc
'set reserved * off'
do index = reserved.0 to 1 by -1
   'set reserved' reserved.index
end
'restore'
if savedline > 0 & savedcolumn > 0 then
   'cursor goto' savedline savedcolumn
else if savedrow > 0 & savedcell > 0 then
   'cursor screen' savedrow savedcell
exit readrc
