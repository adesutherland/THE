options levelb
import rxfnsb

arg args = .string[]

mode = "html"
format = "html"
pdf = 0
pdf_engine = "auto"
renderer = "render-html.crexx"
the_bin = "the"
the_home = "."
crexx_bin = "crexx"
parser = "rxc"
parser_command = "rxc"
rxas_parser_command = ""
template_dir = ""
timeout = "5000"
input_path = ""
output_path = ""
parser_arg_values = .string[]

ai = 1
do while ai <= args.0
  token = args[ai]
  select
    when token = "--scan" then mode = "scan"
    when token = "--validate" then mode = "validate"
    when token = "--format" then do
      ai = ai + 1
      if ai > args.0 then call usage_error "--format needs a value"
      format = args[ai]
      if format <> "html" & format <> "tex" then call usage_error "--format must be html or tex"
    end
    when token = "--pdf" then do
      pdf = 1
      format = "tex"
    end
    when token = "--pdf-engine" then do
      ai = ai + 1
      if ai > args.0 then call usage_error "--pdf-engine needs a value"
      pdf_engine = args[ai]
      if pdf_engine <> "auto" & pdf_engine <> "tectonic" & pdf_engine <> "latexmk" then call usage_error "--pdf-engine must be auto, tectonic, or latexmk"
    end
    when token = "--renderer" then do
      ai = ai + 1
      if ai > args.0 then call usage_error "--renderer needs a value"
      renderer = args[ai]
    end
    when token = "--the" then do
      ai = ai + 1
      if ai > args.0 then call usage_error "--the needs a value"
      the_bin = args[ai]
    end
    when token = "--home" then do
      ai = ai + 1
      if ai > args.0 then call usage_error "--home needs a value"
      the_home = args[ai]
    end
    when token = "--crexx" then do
      ai = ai + 1
      if ai > args.0 then call usage_error "--crexx needs a value"
      crexx_bin = args[ai]
    end
    when token = "--parser" then do
      ai = ai + 1
      if ai > args.0 then call usage_error "--parser needs a value"
      parser = args[ai]
    end
    when token = "--parser-command" then do
      ai = ai + 1
      if ai > args.0 then call usage_error "--parser-command needs a value"
      parser_command = args[ai]
    end
    when token = "--rxas-parser-command" then do
      ai = ai + 1
      if ai > args.0 then call usage_error "--rxas-parser-command needs a value"
      rxas_parser_command = args[ai]
    end
    when token = "--parser-arg" then do
      ai = ai + 1
      if ai > args.0 then call usage_error "--parser-arg needs a value"
      call arrayappend parser_arg_values, args[ai]
    end
    when token = "--template-dir" then do
      ai = ai + 1
      if ai > args.0 then call usage_error "--template-dir needs a value"
      template_dir = args[ai]
    end
    when token = "--timeout" then do
      ai = ai + 1
      if ai > args.0 then call usage_error "--timeout needs a value"
      timeout = args[ai]
    end
    when token = "--output" then do
      ai = ai + 1
      if ai > args.0 then call usage_error "--output needs a value"
      output_path = args[ai]
    end
    otherwise do
      if left(token, 1) = "-" then call usage_error "unexpected argument: " || token
      if input_path = "" then input_path = token
      else if output_path = "" then output_path = token
      else call usage_error "unexpected argument: " || token
    end
  end
  ai = ai + 1
end

if input_path = "" then call usage_error "markdown-file is required"
if positive_integer(timeout) = 0 then call usage_error "--timeout must be a positive integer"
if parser_arg_values.0 = 0 then call arrayappend parser_arg_values, "--syntaxhighlight"
if mode = "html" & output_path = "" then do
  if pdf = 1 then output_path = default_output_path(input_path, "pdf")
  else output_path = default_output_path(input_path, format)
end
if mode = "html" & template_dir = "" then template_dir = document_directory(renderer) || "/templates/" || format || "/default"

if readable_file(renderer) = 0 then do
  call diagnostic_message "batch-md-rexx: renderer not readable: " || renderer
  exit 2
end
if readable_file(input_path) = 0 then do
  call diagnostic_message "batch-md-rexx: markdown file not readable: " || input_path
  exit 2
end
if command_available(crexx_bin) = 0 then do
  call diagnostic_message "batch-md-rexx: CREXX command not found or not executable: " || crexx_bin
  exit 2
end
if mode = "html" | mode = "validate" then do
  if command_available(the_bin) = 0 then do
    call diagnostic_message "batch-md-rexx: THE command not found or not executable: " || the_bin
    exit 2
  end
  if readable_directory(the_home) = 0 then do
    call diagnostic_message "batch-md-rexx: THE home directory not readable: " || the_home
    exit 2
  end
  if command_available(parser_command) = 0 then do
    call diagnostic_message "batch-md-rexx: parser command not found or not executable: " || parser_command
    exit 2
  end
  if rxas_parser_command <> "" then do
    if command_available(rxas_parser_command) = 0 then do
      call diagnostic_message "batch-md-rexx: RXAS parser command not found or not executable: " || rxas_parser_command
      exit 2
    end
  end
end

select
  when mode = "scan" then call diagnostic_message "batch-md-rexx: scanning " || input_path
  when mode = "validate" then call diagnostic_message "batch-md-rexx: validating " || input_path
  otherwise do
    if pdf = 1 then call diagnostic_message "batch-md-rexx: rendering PDF " || input_path || " -> " || output_path
    else call diagnostic_message "batch-md-rexx: rendering " || format || " " || input_path || " -> " || output_path
  end
end

renderer_command = shell_quote(crexx_bin) || " -nokeep " || shell_quote(renderer) || " -args"
if mode = "scan" then renderer_command = renderer_command || " --scan"
if mode = "validate" then renderer_command = renderer_command || " --validate"
if mode = "html" | mode = "validate" then do
  renderer_command = renderer_command || " --format " || shell_quote(format)
  renderer_command = renderer_command || " --the " || shell_quote(the_bin)
  renderer_command = renderer_command || " --home " || shell_quote(the_home)
  renderer_command = renderer_command || " --crexx " || shell_quote(crexx_bin)
  renderer_command = renderer_command || " --parser " || shell_quote(parser)
  renderer_command = renderer_command || " --parser-command " || shell_quote(parser_command)
  if rxas_parser_command <> "" then renderer_command = renderer_command || " --rxas-parser-command " || shell_quote(rxas_parser_command)
  do pai = 1 to parser_arg_values.0
    renderer_command = renderer_command || " --parser-arg " || shell_quote(parser_arg_values[pai])
  end
  if mode = "html" then renderer_command = renderer_command || " --template-dir " || shell_quote(template_dir)
  renderer_command = renderer_command || " --timeout " || shell_quote(timeout)
end
renderer_command = renderer_command || " " || shell_quote(input_path)

command_lines = .string[]
command_lines[1] = renderer_command
render_out = .string[]
render_err = .string[]
address command "sh" input command_lines output render_out error render_err
render_rc = rc

call write_stem "stderr", render_err
if render_rc <> 0 then do
  call diagnostic_message "batch-md-rexx: renderer failed with rc " || render_rc
  exit render_rc
end

if mode = "html" then do
  if pdf = 1 then do
    temp_dir = make_temp_dir()
    if temp_dir = "" then exit 2
    tex_path = temp_dir || "/document.tex"
    if write_lines_to_file(tex_path, render_out) <> 0 then do
      call remove_tree temp_dir
      call diagnostic_message "batch-md-rexx: could not write temporary TeX file"
      exit 2
    end
    pdf_rc = compile_pdf(tex_path, temp_dir, output_path, pdf_engine)
    call remove_tree temp_dir
    if pdf_rc <> 0 then exit pdf_rc
    call diagnostic_message "batch-md-rexx: wrote " || output_path
  end
  else do
    if write_lines_to_file(output_path, render_out) <> 0 then do
      call diagnostic_message "batch-md-rexx: could not write output file: " || output_path
      exit 2
    end
    call diagnostic_message "batch-md-rexx: wrote " || output_path
  end
end
else if mode = "scan" then do
  if output_path <> "" then do
    if write_lines_to_file(output_path, render_out) <> 0 then do
      call diagnostic_message "batch-md-rexx: could not write output file: " || output_path
      exit 2
    end
    call diagnostic_message "batch-md-rexx: wrote " || output_path
  end
  else call write_stem "stdout", render_out
end
else do
  call diagnostic_message "batch-md-rexx: validation passed"
end

exit 0

usage_error: procedure
  arg message = .string
  call diagnostic_message "batch-md-rexx: " || message
  call diagnostic_message "usage: batch-md-rexx [--scan|--validate] [--format html|tex] [--pdf] [--pdf-engine auto|tectonic|latexmk] [--renderer RENDERER] [--the THE] [--home THE_HOME] [--crexx CREXX] [--parser NAME] [--parser-command COMMAND] [--rxas-parser-command COMMAND] [--parser-arg ARG] [--template-dir DIR] [--timeout MS] markdown-file [output]"
  exit 2
return

diagnostic_message: procedure
  arg message = .string
  call lineout "stderr", message
return

readable_file: procedure = .int
  arg path = .string
  if path = "" then return 0
  command_lines = .string[]
  command_lines[1] = "test -r " || shell_quote(path) || " -a -f " || shell_quote(path)
  address command "sh" input command_lines
  if rc = 0 then return 1
return 0

readable_directory: procedure = .int
  arg path = .string
  if path = "" then return 0
  command_lines = .string[]
  command_lines[1] = "test -r " || shell_quote(path) || " -a -d " || shell_quote(path)
  address command "sh" input command_lines
  if rc = 0 then return 1
return 0

command_available: procedure = .int
  arg command_name = .string
  if command_name = "" then return 0
  command_lines = .string[]
  command_lines[1] = "command -v " || shell_quote(command_name) || " >/dev/null 2>&1"
  address command "sh" input command_lines
  if rc = 0 then return 1
return 0

native_file_path: procedure = .string
  arg path = .string
  if path = "" then return path
  if left(path, 1) <> "/" then return path
  out = .string[]
  err = .string[]
  address command "cygpath -w " || shell_quote(path) output out error err
  if rc = 0 & out.0 > 0 then do
    if out[1] <> "" then return out[1]
  end
return path

write_lines_to_file: procedure = .int
  arg path = .string, lines = .string[]
  file_path = native_file_path(path)
  if create_empty_file(file_path) <> 0 then return 1
  if lines.0 = 0 then return 0
  do wi = 1 to lines.0
    write_rc = lineout(file_path, lines[wi])
    if write_rc <> 0 then return 1
  end
  call lineout(file_path)
return 0

create_empty_file: procedure = .int
  arg path = .string
  file_path = native_file_path(path)
  fid = 0
  mode = "w"
  assembler fopen fid,file_path,mode
  if fid = 0 then return 1
  close_rc = 0
  assembler fclose close_rc,fid
  if close_rc <> 0 then return 1
return 0

write_stem: procedure
  arg target = .string, values = .string[]
  do wi = 1 to values.0
    call lineout target, values[wi]
  end
return

make_temp_dir: procedure = .string
  mkout = .string[]
  mkerr = .string[]
  address command "mktemp -d /tmp/the-batch-md-rexx-pdf.XXXXXX" output mkout error mkerr
  if rc <> 0 | mkout.0 = 0 | mkout[1] = "" then do
    call diagnostic_message "batch-md-rexx: mktemp failed while preparing PDF output"
    call write_stem "stderr", mkerr
    return ""
  end
return mkout[1]

compile_pdf: procedure = .int
  arg tex_path = .string, temp_dir = .string, output_path = .string, requested_engine = .string
  engine = resolve_pdf_engine(requested_engine)
  if engine = "" then return 2

  pdf_path = temp_dir || "/document.pdf"
  engine_name = command_basename(engine)
  compile_command = ""
  if engine_name = "latexmk" then do
    compile_command = shell_quote(engine) || " -pdf -interaction=nonstopmode -halt-on-error -outdir=" || shell_quote(temp_dir) || " " || shell_quote(tex_path)
  end
  else do
    compile_command = shell_quote(engine) || " --outdir " || shell_quote(temp_dir) || " " || shell_quote(tex_path)
  end

  call diagnostic_message "batch-md-rexx: compiling PDF with " || engine_name
  compile_lines = .string[]
  compile_lines[1] = compile_command
  compile_out = .string[]
  compile_err = .string[]
  address command "sh" input compile_lines output compile_out error compile_err
  compile_rc = rc
  if compile_rc <> 0 then do
    call write_stem "stdout", compile_out
    call write_stem "stderr", compile_err
    call diagnostic_message "batch-md-rexx: PDF compiler failed with rc " || compile_rc
    return compile_rc
  end

  if readable_file(pdf_path) = 0 then do
    call write_stem "stdout", compile_out
    call write_stem "stderr", compile_err
    call diagnostic_message "batch-md-rexx: PDF compiler did not produce " || pdf_path
    return 2
  end

  copy_lines = .string[]
  copy_lines[1] = "cp " || shell_quote(pdf_path) || " " || shell_quote(output_path)
  copy_out = .string[]
  copy_err = .string[]
  address command "sh" input copy_lines output copy_out error copy_err
  if rc <> 0 then do
    call write_stem "stderr", copy_err
    call diagnostic_message "batch-md-rexx: could not write PDF output: " || output_path
    return 2
  end
return 0

resolve_pdf_engine: procedure = .string
  arg requested_engine = .string
  if requested_engine = "" then requested_engine = "auto"
  if requested_engine = "auto" then do
    if command_available("tectonic") = 1 then return "tectonic"
    if command_available("latexmk") = 1 then return "latexmk"
    call diagnostic_message "batch-md-rexx: no PDF engine found; install tectonic or latexmk, or generate --format tex"
    return ""
  end
  if command_available(requested_engine) = 1 then return requested_engine
  call diagnostic_message "batch-md-rexx: PDF engine not found or not executable: " || requested_engine
return ""

command_basename: procedure = .string
  arg path = .string
  slash = lastpos("/", path)
  backslash = lastpos("\", path)
  if backslash > slash then slash = backslash
  if slash = 0 then return path
return substr(path, slash + 1)

remove_tree: procedure
  arg path = .string
  if path = "" then return
  command_lines = .string[]
  command_lines[1] = "rm -rf " || shell_quote(path)
  address command "sh" input command_lines
return

default_output_path: procedure = .string
  arg path = .string, extension = .string
  if extension = "" then extension = "html"
  slash = lastpos("/", path)
  backslash = lastpos("\", path)
  if backslash > slash then slash = backslash
  dot = lastpos(".", path)
  if dot > slash then return substr(path, 1, dot - 1) || "." || extension
return path || "." || extension

document_directory: procedure = .string
  arg path = .string
  slash = lastpos("/", path)
  backslash = lastpos("\", path)
  if backslash > slash then slash = backslash
  if slash = 0 then return "."
return substr(path, 1, slash - 1)

positive_integer: procedure = .int
  arg value = .string
  if value = "" then return 0
  if verify(value, "0123456789") <> 0 then return 0
  if value <= 0 then return 0
return 1

shell_quote: procedure = .string
  arg value = .string
  quoted = "'"
  do qi = 1 to length(value)
    ch = substr(value, qi, 1)
    if ch = "'" then quoted = quoted || "'""'""'"
    else quoted = quoted || ch
  end
return quoted || "'"
