#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
tool_dir=""
default_the_home="${script_dir}"

if [ -f "${script_dir}/batch-md-rexx.crexx" ] && [ -f "${script_dir}/render-html.crexx" ]; then
  tool_dir="${script_dir}"
elif [ -f "${script_dir}/../share/the/batch-md-rexx/batch-md-rexx.crexx" ]; then
  tool_dir="${script_dir}/../share/the/batch-md-rexx"
  default_the_home="${script_dir}/../share/the"
elif [ -f "${script_dir}/batch-md-rexx/batch-md-rexx.crexx" ]; then
  tool_dir="${script_dir}/batch-md-rexx"
fi

if [ -z "${tool_dir}" ]; then
  echo "the-batch-md-rexx: could not locate batch-md-rexx.crexx" >&2
  exit 2
fi

CREXX_CMD=${CREXX:-crexx}
THE_CMD=${THE_BIN:-the}
THE_HOME_CMD=${THE_HOME_DIR:-${default_the_home}}
if [ "${THE_CREXX_RXC:-}" ]; then
  RXC_CMD=${THE_CREXX_RXC}
else
  crexx_dir=$(CDPATH= cd -- "$(dirname -- "${CREXX_CMD}")" 2>/dev/null && pwd || :)
  if [ -n "${crexx_dir}" ] && [ -x "${crexx_dir}/rxc" ]; then
    RXC_CMD="${crexx_dir}/rxc"
  else
    RXC_CMD=rxc
  fi
fi

exec "${CREXX_CMD}" -nokeep "${tool_dir}/batch-md-rexx.crexx" -args \
  --renderer "${tool_dir}/render-html.crexx" \
  --the "${THE_CMD}" \
  --home "${THE_HOME_CMD}" \
  --crexx "${CREXX_CMD}" \
  --parser rxc \
  --parser-command "${RXC_CMD}" \
  --parser-arg --syntaxhighlight \
  "$@"
