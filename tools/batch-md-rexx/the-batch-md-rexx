#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
tool_dir=""
default_the_home="${script_dir}"

if [ -f "${script_dir}/batch-md-rexx.crexx" ] && [ -f "${script_dir}/render-html.crexx" ]; then
  tool_dir="${script_dir}"
elif [ -f "${script_dir}/../share/the/batch-md-rexx/batch-md-rexx.crexx" ]; then
  tool_dir="${script_dir}/../share/the/batch-md-rexx"
  default_the_home="${script_dir}/../share/the"
elif [ -f "${script_dir}/batch-md-rexx/batch-md-rexx.crexx" ]; then
  tool_dir="${script_dir}/batch-md-rexx"
fi

if [ -z "${tool_dir}" ]; then
  echo "the-batch-md-rexx: could not locate batch-md-rexx.crexx" >&2
  exit 2
fi

CREXX_CMD=${CREXX:-crexx}
THE_CMD=${THE_BIN:-the}
THE_HOME_CMD=${THE_HOME_DIR:-${default_the_home}}
BATCH_DRIVER_PATH=${tool_dir}/batch-md-rexx.crexx
BATCH_DRIVER_MODE=-nokeep
if [ -f "${tool_dir}/batch-md-rexx.rxbin" ]; then
  BATCH_DRIVER_PATH=${tool_dir}/batch-md-rexx.rxbin
  BATCH_DRIVER_MODE=-nocompile
fi
RENDERER_PATH=${tool_dir}/render-html.crexx
if [ -f "${tool_dir}/render-html.rxbin" ]; then
  RENDERER_PATH=${tool_dir}/render-html.rxbin
fi
HIGHLIGHT_PROFILE=${tool_dir}/highlight-source-profile.the
if [ "${THE_CREXX_RXC:-}" ]; then
  RXC_CMD=${THE_CREXX_RXC}
else
  crexx_dir=$(CDPATH= cd -- "$(dirname -- "${CREXX_CMD}")" 2>/dev/null && pwd || :)
  if [ -n "${crexx_dir}" ] && [ -x "${crexx_dir}/rxc" ]; then
    RXC_CMD="${crexx_dir}/rxc"
  else
    RXC_CMD=rxc
  fi
fi

RXAS_CMD=""
if [ "${THE_CREXX_RXAS:-}" ]; then
  RXAS_CMD=${THE_CREXX_RXAS}
else
  rxc_dir=$(CDPATH= cd -- "$(dirname -- "${RXC_CMD}")" 2>/dev/null && pwd || :)
  if [ -n "${rxc_dir}" ] && [ -x "${rxc_dir}/rxas" ]; then
    RXAS_CMD="${rxc_dir}/rxas"
  elif command -v rxas >/dev/null 2>&1; then
    RXAS_CMD=$(command -v rxas)
  fi
fi

if [ -n "${RXAS_CMD}" ]; then
  exec env -u CREXX -u THE_BIN -u THE_HOME_DIR -u THE_CREXX_RXC -u THE_CREXX_RXAS -u THE_BATCH_HIGHLIGHT_PROFILE \
    THE_BATCH_HIGHLIGHT_PROFILE="${HIGHLIGHT_PROFILE}" \
    "${CREXX_CMD}" "${BATCH_DRIVER_MODE}" "${BATCH_DRIVER_PATH}" -args \
    --renderer "${RENDERER_PATH}" \
    --the "${THE_CMD}" \
    --home "${THE_HOME_CMD}" \
    --crexx "${CREXX_CMD}" \
    --parser rxc \
    --parser-command "${RXC_CMD}" \
    --rxas-parser-command "${RXAS_CMD}" \
    --parser-arg --syntaxhighlight \
    "$@"
fi

exec env -u CREXX -u THE_BIN -u THE_HOME_DIR -u THE_CREXX_RXC -u THE_CREXX_RXAS -u THE_BATCH_HIGHLIGHT_PROFILE \
  THE_BATCH_HIGHLIGHT_PROFILE="${HIGHLIGHT_PROFILE}" \
  "${CREXX_CMD}" "${BATCH_DRIVER_MODE}" "${BATCH_DRIVER_PATH}" -args \
  --renderer "${RENDERER_PATH}" \
  --the "${THE_CMD}" \
  --home "${THE_HOME_CMD}" \
  --crexx "${CREXX_CMD}" \
  --parser rxc \
  --parser-command "${RXC_CMD}" \
  --parser-arg --syntaxhighlight \
  "$@"
