options levelb
import rxfnsb

arg args = .string[]

mode = "html"
path = ""
the_bin = ""
the_home = ""
crexx_bin = ""
parser = "rxc"
parser_command = ""
parser_args = ""
timeout = "5000"

ai = 1
do while ai <= args.0
  token = args[ai]
  select
    when token = "--scan" then mode = "scan"
    when token = "--validate" then mode = "validate"
    when token = "--the" then do
      ai = ai + 1
      if ai > args.0 then call usage_error "--the needs a value"
      the_bin = args[ai]
    end
    when token = "--home" then do
      ai = ai + 1
      if ai > args.0 then call usage_error "--home needs a value"
      the_home = args[ai]
    end
    when token = "--crexx" then do
      ai = ai + 1
      if ai > args.0 then call usage_error "--crexx needs a value"
      crexx_bin = args[ai]
    end
    when token = "--parser" then do
      ai = ai + 1
      if ai > args.0 then call usage_error "--parser needs a value"
      parser = args[ai]
    end
    when token = "--parser-command" then do
      ai = ai + 1
      if ai > args.0 then call usage_error "--parser-command needs a value"
      parser_command = args[ai]
    end
    when token = "--parser-arg" then do
      ai = ai + 1
      if ai > args.0 then call usage_error "--parser-arg needs a value"
      if parser_args = "" then parser_args = args[ai]
      else parser_args = parser_args || " " || args[ai]
    end
    when token = "--timeout" then do
      ai = ai + 1
      if ai > args.0 then call usage_error "--timeout needs a value"
      timeout = args[ai]
    end
    otherwise do
      if path = "" then path = token
      else call usage_error "unexpected argument: " || token
    end
  end
  ai = ai + 1
end

if path = "" then call usage_error "markdown-file is required"
if crexx_bin = "" then crexx_bin = "crexx"
if parser_command = "" then parser_command = parser
if parser_args = "" then parser_args = "--syntaxhighlight"
if positive_integer(timeout) = 0 then call usage_error "--timeout must be a positive integer"
if mode = "html" | mode = "validate" then do
  if the_bin = "" then call usage_error "--the is required for HTML rendering"
  if the_home = "" then call usage_error "--home is required for HTML rendering"
end

source = .string[]
do forever
  available = lines(path)
  if available < 0 then do
    call diagnostic_message "render-html.crexx: cannot read markdown file: " || path
    exit 2
  end
  if available = 0 then leave
  call arrayappend source, linein(path)
end

manifest = .string[]
failures = scan_markdown(path, source, manifest)
if failures > 0 then exit 1

if mode = "scan" then do
  do mi = 1 to manifest.0
    say manifest[mi]
  end
  exit 0
end

render_rc = render_html_document(path, source, manifest, the_bin, the_home, crexx_bin, parser, parser_command, parser_args, timeout, mode)
exit render_rc

usage_error: procedure
  arg message = .string
  call diagnostic_message "render-html.crexx: " || message
  call diagnostic_message "usage: render-html.crexx [--scan|--validate] [--the THE --home THE_HOME] [--crexx CREXX] [--parser NAME] [--parser-command COMMAND] [--parser-arg ARG] [--timeout MS] markdown-file"
  exit 2
return

diagnostic: procedure
  arg file = .string, line_no = .int, message = .string
  call diagnostic_message file || ":" || line_no || ": error: " || message
return

diagnostic_message: procedure
  arg message = .string
  call lineout "stderr", message
return

scan_markdown: procedure = .int
  arg path = .string, source = .string[], expose manifest = .string[]

  failures = 0
  seen_ids = .string[]
  seen_lines = .string[]
  markdown_start = 1
  line_count = source.0
  i = 1

  do while i <= line_count
    fence = opening_fence(source[i])
    if fence = "" then do
      i = i + 1
      iterate
    end

    info = fence_info(source[i], fence)
    language = lower(word(info, 1))
    j = i + 1
    do while j <= line_count
      if closing_fence(source[j], fence) = 1 then leave
      j = j + 1
    end
    if j > line_count then do
      call diagnostic path, i, "unterminated fenced code block"
      failures = failures + 1
      leave
    end

    if is_example_language(language) = 1 then do
      tokens = .string[]
      token_count = tokenize_info(info, tokens)
      if token_count < 0 then do
        call diagnostic path, i, "invalid fence attributes: unterminated quote"
        failures = failures + 1
      end
      else do
        id = ""
        run = "false"
        kind = "standalone"
        output = "text"
        expect = ""
        timeout = ""
        allow_rc = "0"
        fail_diag = "true"
        seen_keys = .string[]
        block_failures = 0

        do ti = 2 to token_count
          token = tokens[ti]
          eq = pos("=", token)
          if eq = 0 then do
            call diagnostic path, i, "expected key=value attribute, got '" || token || "'"
            block_failures = block_failures + 1
            iterate
          end
          key = substr(token, 1, eq - 1)
          value = substr(token, eq + 1)
          if is_allowed_attribute(key) = 0 then do
            call diagnostic path, i, "unknown attribute '" || key || "'"
            block_failures = block_failures + 1
            iterate
          end
          if value = "" then do
            call diagnostic path, i, "attribute '" || key || "' must not be empty"
            block_failures = block_failures + 1
            iterate
          end
          if string_array_index(seen_keys, key) > 0 then do
            call diagnostic path, i, "duplicate attribute '" || key || "'"
            block_failures = block_failures + 1
            iterate
          end
          call arrayappend seen_keys, key

          select
            when key = "id" then id = value
            when key = "run" then run = value
            when key = "kind" then kind = value
            when key = "output" then output = value
            when key = "expect" then expect = value
            when key = "timeout" then timeout = value
            when key = "allow-rc" then allow_rc = value
            when key = "fail-on-diagnostics" then fail_diag = value
            otherwise nop
          end
        end

        if id = "" then do
          call diagnostic path, i, "REXX example fence is missing required id attribute"
          block_failures = block_failures + 1
        end
        else if valid_identifier(id) = 0 then do
          call diagnostic path, i, "invalid example id '" || id || "'; expected [A-Za-z][A-Za-z0-9_.-]*"
          block_failures = block_failures + 1
        end
        else do
          existing = string_array_index(seen_ids, id)
          if existing > 0 then do
            call diagnostic path, i, "duplicate example id '" || id || "' first defined on line " || seen_lines[existing]
            block_failures = block_failures + 1
          end
          else do
            call arrayappend seen_ids, id
            call arrayappend seen_lines, i
          end
        end

        if run <> "true" & run <> "false" then do
          call diagnostic path, i, "run must be true or false, got '" || run || "'"
          block_failures = block_failures + 1
        end
        if fail_diag <> "true" & fail_diag <> "false" then do
          call diagnostic path, i, "fail-on-diagnostics must be true or false, got '" || fail_diag || "'"
          block_failures = block_failures + 1
        end
        if kind <> "standalone" & kind <> "the-macro" & kind <> "address-the" then do
          call diagnostic path, i, "kind must be standalone, the-macro, or address-the, got '" || kind || "'"
          block_failures = block_failures + 1
        end
        if valid_identifier(output) = 0 then do
          call diagnostic path, i, "invalid output name '" || output || "'"
          block_failures = block_failures + 1
        end
        if timeout <> "" then do
          if positive_integer(timeout) = 0 then do
            call diagnostic path, i, "timeout must be a positive integer, got '" || timeout || "'"
            block_failures = block_failures + 1
          end
        end
        if allow_rc <> "*" then do
          if non_negative_integer(allow_rc) = 0 then do
            call diagnostic path, i, "allow-rc must be a non-negative integer or *, got '" || allow_rc || "'"
            block_failures = block_failures + 1
          end
        end

        failures = failures + block_failures
        if block_failures = 0 then do
          if markdown_start <= i - 1 then do
            call arrayappend manifest, "markdown start=" || markdown_start || " end=" || (i - 1)
          end
          record = "example id=" || id || " language=" || language
          record = record || " opening=" || i || " body-start=" || (i + 1)
          record = record || " body-end=" || (j - 1) || " closing=" || j
          record = record || " run=" || run || " kind=" || kind || " output=" || output
          record = record || " allow-rc=" || allow_rc || " fail-on-diagnostics=" || fail_diag
          if timeout <> "" then record = record || " timeout=" || timeout
          if expect <> "" then record = record || " expect=" || expect
          call arrayappend manifest, record
          markdown_start = j + 1
        end
      end
    end

    i = j + 1
  end

  if failures = 0 then do
    if markdown_start <= line_count then do
      call arrayappend manifest, "markdown start=" || markdown_start || " end=" || line_count
    end
  end

return failures

render_html_document: procedure = .int
  arg path = .string, source = .string[], manifest = .string[], the_bin = .string, the_home = .string, crexx_bin = .string, parser = .string, parser_command = .string, parser_args = .string, timeout = .string, mode = .string

  emit_html = 1
  if mode = "validate" then emit_html = 0

  if emit_html = 1 then do
    say "<!doctype html>"
    say '<html lang="en">'
    say "<head>"
    say '  <meta charset="utf-8">'
    say '  <title>' || html_escape(path) || "</title>"
    call emit_css
    say "</head>"
    say "<body>"
    say '<main class="the-batch-document">'
  end

  do mi = 1 to manifest.0
    record = manifest[mi]
    if left(record, 8) = "markdown" then do
      if emit_html = 1 then do
        start_line = manifest_value(record, "start")
        end_line = manifest_value(record, "end")
        call emit_markdown_segment source, start_line, end_line
      end
    end
    else if left(record, 7) = "example" then do
      rc = emit_example(source, record, path, the_bin, the_home, crexx_bin, parser, parser_command, parser_args, timeout, emit_html)
      if rc <> 0 then return rc
    end
  end

  if emit_html = 1 then do
    say "</main>"
    say "</body>"
    say "</html>"
  end
return 0

emit_css: procedure
  say "<style>"
  say ":root { color-scheme: light; --the-bg: #f8fafc; --the-border: #cbd5e1; --the-text: #1f2937; }"
  say "body { margin: 0; font: 15px/1.5 system-ui, -apple-system, BlinkMacSystemFont, sans-serif; color: var(--the-text); background: white; }"
  say ".the-batch-document { max-width: 980px; margin: 0 auto; padding: 32px 24px; }"
  say ".markdown pre { white-space: pre-wrap; margin: 0 0 20px; font: inherit; }"
  say ".the-example { margin: 22px 0; }"
  say ".the-example figcaption { margin-bottom: 6px; color: #475569; font: 600 13px/1.4 system-ui, sans-serif; }"
  say ".the-example-source { margin: 0; padding: 14px 16px; overflow-x: auto; border: 1px solid var(--the-border); border-radius: 6px; background: var(--the-bg); }"
  say ".the-example-source code { font: 13px/1.55 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }"
  say ".the-example-run { border: 1px solid var(--the-border); border-top: 0; border-radius: 0 0 6px 6px; background: #fff; }"
  say ".the-run-status { margin: 0; padding: 8px 16px; color: #475569; font: 12px/1.4 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; border-top: 1px solid var(--the-border); }"
  say ".the-output { margin: 0; padding: 12px 16px; overflow-x: auto; border-top: 1px solid var(--the-border); background: #ffffff; }"
  say ".the-output code { font: 13px/1.55 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }"
  say ".the-output-stderr { background: #fff7ed; }"
  say ".the-output-messages { background: #f8fafc; }"
  say ".the-output-markdown { white-space: normal; }"
  say ".the-output-markdown h3, .the-output-markdown h4, .the-output-markdown p, .the-output-markdown ul, .the-output-markdown ol, .the-output-markdown blockquote, .the-output-markdown table, .the-output-markdown pre { margin: 0 0 10px; }"
  say ".the-output-markdown h3 { font: 700 16px/1.35 system-ui, sans-serif; }"
  say ".the-output-markdown h4 { font: 700 14px/1.35 system-ui, sans-serif; }"
  say ".the-output-markdown table { border-collapse: collapse; width: max-content; max-width: 100%; }"
  say ".the-output-markdown th, .the-output-markdown td { border: 1px solid var(--the-border); padding: 4px 8px; text-align: left; }"
  say ".the-output-markdown th { background: var(--the-bg); }"
  say ".the-output-markdown blockquote { border-left: 3px solid var(--the-border); padding-left: 10px; color: #475569; }"
  say ".syn-comment { color: #6a9955; font-style: italic; }"
  say ".syn-string { color: #a31515; }"
  say ".syn-number { color: #098658; }"
  say ".syn-keyword { color: #0000ff; font-weight: 600; }"
  say ".syn-preprocessor { color: #795e26; }"
  say ".syn-type { color: #267f99; }"
  say ".syn-function { color: #795e26; }"
  say ".syn-constant { color: #0070c1; }"
  say ".syn-identifier { color: #001080; }"
  say ".syn-operator, .syn-punctuation, .syn-paren { color: #374151; }"
  say "</style>"
return

emit_markdown_segment: procedure
  arg source = .string[], start_line = .int, end_line = .int
  if start_line > end_line then return
  say '<div class="markdown"><pre>'
  do line_no = start_line to end_line
    say html_escape(source[line_no])
  end
  say "</pre></div>"
return

emit_example: procedure = .int
  arg source = .string[], record = .string, document_path = .string, the_bin = .string, the_home = .string, crexx_bin = .string, parser = .string, parser_command = .string, parser_args = .string, timeout = .string, emit_html = .int

  id = manifest_value(record, "id")
  language = manifest_value(record, "language")
  body_start = manifest_value(record, "body-start")
  body_end = manifest_value(record, "body-end")
  run_attr = manifest_value(record, "run")
  kind = manifest_value(record, "kind")
  output = manifest_value(record, "output")
  expect = manifest_value(record, "expect")
  allow_rc = manifest_value(record, "allow-rc")
  fail_diag = manifest_value(record, "fail-on-diagnostics")
  block_timeout = manifest_value(record, "timeout")
  source_lines = .string[]
  spans = .string[]
  render_spans = .string[]
  run_stdout = .string[]
  run_stderr = .string[]
  run_messages = .string[]
  run_meta = .string[]
  run_rc = "0"
  timed_out = "0"

  if block_timeout = "" then block_timeout = timeout
  if allow_rc = "" then allow_rc = "0"

  do line_no = body_start to body_end
    call arrayappend source_lines, source[line_no]
  end

  rc = highlight_source(id, language, source_lines, the_bin, the_home, parser, parser_command, parser_args, timeout, fail_diag, spans)
  if rc <> 0 then return rc
  do si = 1 to spans.0
    span_record = spans[si]
    call arrayappend render_spans, span_record
  end

  if run_attr = "true" then do
    rc = execute_example(id, language, kind, source_lines, the_bin, the_home, crexx_bin, block_timeout, run_stdout, run_stderr, run_messages, run_meta)
    if rc <> 0 then return rc
    if run_meta.0 >= 1 then run_rc = run_meta[1]
    if run_meta.0 >= 2 then timed_out = run_meta[2]
    if timed_out = "1" & rc_allowed(allow_rc, run_rc) = 0 then do
      call diagnostic_message "render-html.crexx: example " || id || " timed out with rc " || run_rc
      return 1
    end
    if run_rc <> "0" & rc_allowed(allow_rc, run_rc) = 0 then do
      call diagnostic_message "render-html.crexx: example " || id || " exited with rc " || run_rc
      return 1
    end
    if expect <> "" then do
      rc = validate_expected_output(id, expect, document_path, run_stdout)
      if rc <> 0 then return rc
    end
  end
  else do
    if expect <> "" then do
      call diagnostic_message "render-html.crexx: example " || id || " has expect but run=false"
      return 1
    end
  end

  if emit_html = 1 then do
    say '<figure class="the-example the-example-' || html_escape_attr(language) || '" id="' || html_escape_attr(id) || '">'
    say "<figcaption>" || html_escape(id) || "</figcaption>"
    say '<pre class="the-example-source"><code>'
    do line_no = 1 to source_lines.0
      say highlighted_line(source_lines[line_no], line_no, render_spans)
    end
    say "</code></pre>"
    if run_attr = "true" then do
      call emit_run_output id, output, run_stdout, run_stderr, run_messages, run_rc, the_bin, the_home, parser, parser_command, parser_args, block_timeout
    end
    say "</figure>"
  end
return 0

execute_example: procedure = .int
  arg id = .string, language = .string, kind = .string, source_lines = .string[], the_bin = .string, the_home = .string, crexx_bin = .string, timeout = .string, expose run_stdout = .string[], expose run_stderr = .string[], expose run_messages = .string[], expose run_meta = .string[]

  if kind = "standalone" then do
    child_status = execute_standalone(id, language, source_lines, crexx_bin, timeout, run_stdout, run_stderr, run_meta)
    return child_status
  end
  if kind = "the-macro" then do
    child_status = execute_the_profile(id, kind, source_lines, the_bin, the_home, timeout, run_stdout, run_stderr, run_messages, run_meta)
    return child_status
  end
  if kind = "address-the" then do
    child_status = execute_the_profile(id, kind, source_lines, the_bin, the_home, timeout, run_stdout, run_stderr, run_messages, run_meta)
    return child_status
  end

  call diagnostic_message "render-html.crexx: unsupported example kind " || kind || " in example " || id
return 2

execute_standalone: procedure = .int
  arg id = .string, language = .string, source_lines = .string[], crexx_bin = .string, timeout = .string, expose run_stdout = .string[], expose run_stderr = .string[], expose run_meta = .string[]

  mkout = .string[]
  mkerr = .string[]
  address command "mktemp -d /tmp/the-batch-md-rexx-run.XXXXXX" output mkout error mkerr
  if rc <> 0 | mkout.0 = 0 | mkout[1] = "" then do
    call diagnostic_message "render-html.crexx: mktemp failed while running example " || id
    call write_stem "stderr", mkerr
    return 2
  end

  temp_dir = mkout[1]
  source_path = temp_dir || "/run." || extension_for_language(language)
  if write_lines_to_file(source_path, source_lines) <> 0 then do
    call remove_tree temp_dir
    call diagnostic_message "render-html.crexx: could not write runnable source for example " || id
    return 2
  end

  command_lines = .string[]
  command_lines[1] = timeout_prefix(timeout) || " " || shell_quote(crexx_bin) || " -nokeep " || shell_quote(source_path)
  child_out = .string[]
  child_err = .string[]
  address command "sh" input command_lines output child_out error child_err
  call arrayappend run_meta, "" || rc
  if timeout_rc(rc) = 1 then call arrayappend run_meta, "1"
  else call arrayappend run_meta, "0"
  do oi = 1 to child_out.0
    call arrayappend run_stdout, child_out[oi]
  end
  do ei = 1 to child_err.0
    call arrayappend run_stderr, child_err[ei]
  end
  call remove_tree temp_dir
return 0

execute_the_profile: procedure = .int
  arg id = .string, kind = .string, source_lines = .string[], the_bin = .string, the_home = .string, timeout = .string, expose run_stdout = .string[], expose run_stderr = .string[], expose run_messages = .string[], expose run_meta = .string[]

  mkout = .string[]
  mkerr = .string[]
  address command "mktemp -d /tmp/the-batch-md-rexx-the-run.XXXXXX" output mkout error mkerr
  if rc <> 0 | mkout.0 = 0 | mkout[1] = "" then do
    call diagnostic_message "render-html.crexx: mktemp failed while running THE example " || id
    call write_stem "stderr", mkerr
    return 2
  end

  temp_dir = mkout[1]
  profile_path = temp_dir || "/run-profile.the"
  scratch_path = temp_dir || "/scratch.txt"
  profile = .string[]
  scratch = .string[]
  call arrayappend scratch, ""

  call build_the_run_profile kind, source_lines, profile
  if write_lines_to_file(profile_path, profile) <> 0 then do
    call remove_tree temp_dir
    call diagnostic_message "render-html.crexx: could not write THE profile for example " || id
    return 2
  end
  if write_lines_to_file(scratch_path, scratch) <> 0 then do
    call remove_tree temp_dir
    call diagnostic_message "render-html.crexx: could not write THE scratch file for example " || id
    return 2
  end

  child_out = .string[]
  child_err = .string[]
  command_lines = .string[]
  inner_cmd = "TERM= THE_HOME_DIR=" || shell_quote(the_home) || " " || shell_quote(the_bin)
  inner_cmd = inner_cmd || " -b -q -p " || shell_quote(profile_path) || " " || shell_quote(scratch_path)
  command_lines[1] = timeout_prefix(timeout) || " " || inner_cmd
  address command "sh" input command_lines output child_out error child_err
  call arrayappend run_meta, "" || rc
  if timeout_rc(rc) = 1 then call arrayappend run_meta, "1"
  else call arrayappend run_meta, "0"
  call remove_tree temp_dir

  call append_the_run_stream child_out, "stdout", run_stdout, run_stderr, run_messages
  call append_the_run_stream child_err, "stderr", run_stdout, run_stderr, run_messages
return 0

build_the_run_profile: procedure
  arg kind = .string, source_lines = .string[], expose profile = .string[]

  call arrayappend profile, "options levelb"
  call arrayappend profile, "address the"

  if kind = "address-the" then do
    do line_no = 1 to source_lines.0
      if strip(source_lines[line_no]) <> "" then do
        source_command = source_lines[line_no]
        quoted_command = rexx_single_quote(source_command)
        call arrayappend profile, quoted_command
      end
    end
  end
  else do
    do line_no = 1 to source_lines.0
      normalized = lower(strip(source_lines[line_no]))
      if normalized = "options levelb" then iterate
      if normalized = "import rxfnsb" then iterate
      call arrayappend profile, source_lines[line_no]
    end
  end

  call arrayappend profile, "address the"
  call arrayappend profile, "messages = .string[]"
  call arrayappend profile, 'address the "extract /messages/" expose messages[]'
  call arrayappend profile, "message_count = messages[0]"
  call arrayappend profile, "'emsg THE_BATCH_RUN_MESSAGE_COUNT=' || message_count"
  call arrayappend profile, "do i = 1 to message_count"
  call arrayappend profile, "  'emsg THE_BATCH_RUN_MESSAGE=' || messages[i]"
  call arrayappend profile, "end"
  call arrayappend profile, "'qquit'"
return

append_the_run_stream: procedure
  arg values = .string[], stream_name = .string, expose run_stdout = .string[], expose run_stderr = .string[], expose run_messages = .string[]
  do vi = 1 to values.0
    line = values[vi]
    if left(line, 28) = "THE_BATCH_RUN_MESSAGE_COUNT=" then do
      nop
    end
    else if left(line, 22) = "THE_BATCH_RUN_MESSAGE=" then do
      call arrayappend run_messages, substr(line, 23)
    end
    else if stream_name = "stdout" then do
      call arrayappend run_stdout, line
    end
    else do
      call arrayappend run_stderr, line
    end
  end
return

emit_run_output: procedure
  arg id = .string, output = .string, run_stdout = .string[], run_stderr = .string[], run_messages = .string[], run_rc = .string, the_bin = .string, the_home = .string, parser = .string, parser_command = .string, parser_args = .string, timeout = .string
  say '<div class="the-example-run">'
  say '<p class="the-run-status">rc=' || html_escape(run_rc) || '</p>'
  call emit_output_block id, "stdout", output, run_stdout, the_bin, the_home, parser, parser_command, parser_args, timeout
  call emit_output_block id, "stderr", "text", run_stderr, the_bin, the_home, parser, parser_command, parser_args, timeout
  call emit_output_block id, "messages", "text", run_messages, the_bin, the_home, parser, parser_command, parser_args, timeout
  say "</div>"
return

emit_output_block: procedure
  arg id = .string, stream_name = .string, output = .string, lines = .string[], the_bin = .string, the_home = .string, parser = .string, parser_command = .string, parser_args = .string, timeout = .string
  if lines.0 = 0 then return

  if output = "markdown" then do
    say '<div class="the-output the-output-' || html_escape_attr(stream_name) || ' the-output-markdown">'
    call emit_markdown_output lines
    say "</div>"
    return
  end

  say '<pre class="the-output the-output-' || html_escape_attr(stream_name) || '"><code>'
  if output_highlightable(output, parser) = 1 then do
    spans = .string[]
    render_spans = .string[]
    rc = highlight_source(id || "-" || stream_name, output, lines, the_bin, the_home, parser_for_output(output, parser), parser_command, parser_args, timeout, "false", spans)
    if rc = 0 then do
      do si = 1 to spans.0
        span_record = spans[si]
        call arrayappend render_spans, span_record
      end
      do line_no = 1 to lines.0
        say highlighted_line(lines[line_no], line_no, render_spans)
      end
    end
    else do
      call emit_plain_lines lines
    end
  end
  else do
    call emit_plain_lines lines
  end
  say "</code></pre>"
return

emit_markdown_output: procedure
  arg lines = .string[]

  i = 1
  do while i <= lines.0
    line = lines[i]
    stripped = strip(line)

    if stripped = "" then do
      i = i + 1
      iterate
    end

    if starts_with(stripped, "```") = 1 | starts_with(stripped, "~~~") = 1 then do
      fence = left(stripped, 3)
      say "<pre><code>"
      i = i + 1
      do while i <= lines.0
        if starts_with(strip(lines[i]), fence) = 1 then leave
        say html_escape(lines[i])
        i = i + 1
      end
      say "</code></pre>"
      if i <= lines.0 then i = i + 1
      iterate
    end

    if starts_with(stripped, "### ") = 1 then do
      say "<h4>" || markdown_inline(substr(stripped, 5)) || "</h4>"
      i = i + 1
      iterate
    end
    if starts_with(stripped, "## ") = 1 then do
      say "<h3>" || markdown_inline(substr(stripped, 4)) || "</h3>"
      i = i + 1
      iterate
    end
    if starts_with(stripped, "# ") = 1 then do
      say "<h3>" || markdown_inline(substr(stripped, 3)) || "</h3>"
      i = i + 1
      iterate
    end

    if i < lines.0 then do
      if markdown_table_row(stripped) = 1 & markdown_table_delimiter(lines[i + 1]) = 1 then do
        say "<table>"
        say "<thead>"
        call emit_markdown_table_row stripped, "th"
        say "</thead>"
        say "<tbody>"
        i = i + 2
        do while i <= lines.0
          row = strip(lines[i])
          if markdown_table_row(row) = 0 then leave
          call emit_markdown_table_row row, "td"
          i = i + 1
        end
        say "</tbody>"
        say "</table>"
        iterate
      end
    end

    if starts_with(stripped, "- ") = 1 | starts_with(stripped, "* ") = 1 then do
      say "<ul>"
      do while i <= lines.0
        item = strip(lines[i])
        if starts_with(item, "- ") = 0 & starts_with(item, "* ") = 0 then leave
        say "<li>" || markdown_inline(substr(item, 3)) || "</li>"
        i = i + 1
      end
      say "</ul>"
      iterate
    end

    if starts_with(stripped, "> ") = 1 then do
      say "<blockquote>"
      do while i <= lines.0
        quote_line = strip(lines[i])
        if starts_with(quote_line, "> ") = 0 then leave
        say "<p>" || markdown_inline(substr(quote_line, 3)) || "</p>"
        i = i + 1
      end
      say "</blockquote>"
      iterate
    end

    say "<p>" || markdown_inline(stripped) || "</p>"
    i = i + 1
  end
return

emit_markdown_table_row: procedure
  arg line = .string, cell_tag = .string
  cells = .string[]
  call split_table_cells line, cells
  say "<tr>"
  do ci = 1 to cells.0
    say "<" || cell_tag || ">" || markdown_inline(strip(cells[ci])) || "</" || cell_tag || ">"
  end
  say "</tr>"
return

split_table_cells: procedure
  arg line = .string, expose cells = .string[]
  text = strip(line)
  if left(text, 1) = "|" then text = substr(text, 2)
  if right(text, 1) = "|" then text = substr(text, 1, length(text) - 1)
  current = ""
  do idx = 1 to length(text)
    ch = substr(text, idx, 1)
    if ch = "|" then do
      call arrayappend cells, current
      current = ""
    end
    else current = current || ch
  end
  call arrayappend cells, current
return

markdown_table_row: procedure = .int
  arg line = .string
  if pos("|", line) = 0 then return 0
  if strip(line) = "" then return 0
return 1

markdown_table_delimiter: procedure = .int
  arg line = .string
  cells = .string[]
  call split_table_cells line, cells
  if cells.0 = 0 then return 0
  do ci = 1 to cells.0
    cell = strip(cells[ci])
    if cell = "" then return 0
    dash_seen = 0
    do idx = 1 to length(cell)
      ch = substr(cell, idx, 1)
      if ch = "-" then dash_seen = 1
      else if ch = ":" | ch = " " | ch = '09'x then nop
      else return 0
    end
    if dash_seen = 0 then return 0
  end
return 1

markdown_inline: procedure = .string
  arg text = .string
  out = ""
  in_code = 0

  do idx = 1 to length(text)
    ch = substr(text, idx, 1)
    if ch = "`" then do
      if in_code = 1 then do
        out = out || "</code>"
        in_code = 0
      end
      else do
        out = out || "<code>"
        in_code = 1
      end
    end
    else out = out || html_escape(ch)
  end
  if in_code = 1 then out = out || "</code>"
return out

emit_plain_lines: procedure
  arg lines = .string[]
  do line_no = 1 to lines.0
    say html_escape(lines[line_no])
  end
return

output_highlightable: procedure = .int
  arg output = .string, parser = .string
  if is_example_language(output) = 1 then return 1
  if output = parser then return 1
return 0

parser_for_output: procedure = .string
  arg output = .string, parser = .string
  if is_example_language(output) = 1 then return parser
return output

rc_allowed: procedure = .int
  arg allowed = .string, actual = .string
  if allowed = "*" then return 1
  if actual = allowed then return 1
return 0

validate_expected_output: procedure = .int
  arg id = .string, expect = .string, document_path = .string, actual = .string[]
  expected = .string[]

  rc = load_expected_output(expect, document_path, expected)
  if rc <> 0 then return rc

  limit = expected.0
  if actual.0 - limit < 0 then limit = actual.0
  do line_no = 1 to limit
    expected_line = expected[line_no]
    actual_line = actual[line_no]
    if expected_line <> actual_line then do
      call expected_mismatch id, line_no, expected_line, actual_line
      return 1
    end
  end

  if expected.0 <> actual.0 then do
    diff_line = limit + 1
    expected_line = ""
    actual_line = ""
    if expected.0 - actual.0 > 0 then do
      expected_line = expected[diff_line]
      actual_line = "<missing>"
    end
    else do
      expected_line = "<missing>"
      actual_line = actual[diff_line]
    end
    call expected_mismatch id, diff_line, expected_line, actual_line
    call diagnostic_message "render-html.crexx: expected " || expected.0 || " stdout line(s), got " || actual.0
    return 1
  end

return 0

load_expected_output: procedure = .int
  arg expect = .string, document_path = .string, expose expected = .string[]

  if left(expect, 7) = "inline:" then do
    call arrayappend expected, substr(expect, 8)
    return 0
  end

  expected_path = resolve_expect_path(document_path, expect)
  do forever
    available = lines(expected_path)
    if available < 0 then do
      call diagnostic_message "render-html.crexx: cannot read expected output file: " || expected_path
      return 2
    end
    if available = 0 then leave
    call arrayappend expected, linein(expected_path)
  end
return 0

expected_mismatch: procedure
  arg id = .string, line_no = .int, expected_line = .string, actual_line = .string
  call diagnostic_message "render-html.crexx: expected output mismatch in example " || id
  call diagnostic_message "render-html.crexx: line " || line_no || " expected: " || expected_line
  call diagnostic_message "render-html.crexx: line " || line_no || " actual: " || actual_line
return

resolve_expect_path: procedure = .string
  arg document_path = .string, expect = .string
  if is_absolute_path(expect) = 1 then return expect
  dir = document_directory(document_path)
  if dir = "" then return expect
return dir || "/" || expect

document_directory: procedure = .string
  arg path = .string
  slash = lastpos("/", path)
  backslash = lastpos("\", path)
  if backslash > slash then slash = backslash
  if slash = 0 then return ""
return substr(path, 1, slash - 1)

is_absolute_path: procedure = .int
  arg path = .string
  if left(path, 1) = "/" then return 1
  if length(path) > 2 then do
    if substr(path, 2, 1) = ":" then return 1
  end
return 0

timeout_prefix: procedure = .string
  arg timeout = .string
  seconds = (timeout + 999) % 1000
  if seconds < 1 then seconds = 1
return "perl -e " || shell_quote("alarm shift; exec @ARGV") || " " || seconds

timeout_rc: procedure = .int
  arg value = .string
  if value = "14" then return 1
  if value = "142" then return 1
return 0

highlight_source: procedure = .int
  arg id = .string, language = .string, source_lines = .string[], the_bin = .string, the_home = .string, parser = .string, parser_command = .string, parser_args = .string, timeout = .string, fail_diag = .string, expose spans = .string[]

  mkout = .string[]
  mkerr = .string[]
  address command "mktemp -d /tmp/the-batch-md-rexx-html.XXXXXX" output mkout error mkerr
  if rc <> 0 | mkout.0 = 0 | mkout[1] = "" then do
    call diagnostic_message "render-html.crexx: mktemp failed while highlighting example " || id
    call write_stem "stderr", mkerr
    return 2
  end

  temp_dir = mkout[1]
  extension = extension_for_language(language)
  source_path = temp_dir || "/source." || extension
  profile_path = temp_dir || "/profile.the"

  if write_lines_to_file(source_path, source_lines) <> 0 then do
    call remove_tree temp_dir
    call diagnostic_message "render-html.crexx: could not write source for example " || id
    return 2
  end

  profile = .string[]
  call arrayappend profile, "options levelb"
  call arrayappend profile, "import rxfnsb"
  call arrayappend profile, "address the"
  call arrayappend profile, "'set sdslh " || parser || " " || parser_command || " " || parser_args || "'"
  call arrayappend profile, "'set autocolor *." || extension || " " || parser || "'"
  call arrayappend profile, "'set coloring on auto'"
  call arrayappend profile, "'sdslhwait " || timeout || "'"
  call arrayappend profile, "pmsgs = .string[]"
  call arrayappend profile, 'address the "extract /pmsgs/" expose pmsgs[]'
  call arrayappend profile, "pmsg_count = pmsgs[0]"
  call arrayappend profile, "'emsg THE_BATCH_PMSG_COUNT=' || pmsg_count"
  call arrayappend profile, "do i = 1 to pmsg_count"
  call arrayappend profile, "  'emsg THE_BATCH_PMSG=' || pmsgs[i]"
  call arrayappend profile, "end"
  call arrayappend profile, "stylespans = .string[]"
  call arrayappend profile, 'address the "extract /stylespans/" expose stylespans[]'
  call arrayappend profile, "span_count = stylespans[0]"
  call arrayappend profile, "'emsg THE_BATCH_STYLESPAN_COUNT=' || span_count"
  call arrayappend profile, "do i = 1 to span_count"
  call arrayappend profile, "  'emsg THE_BATCH_STYLESPAN=' || stylespans[i]"
  call arrayappend profile, "end"
  call arrayappend profile, "'qquit'"

  if write_lines_to_file(profile_path, profile) <> 0 then do
    call remove_tree temp_dir
    call diagnostic_message "render-html.crexx: could not write THE profile for example " || id
    return 2
  end

  out = .string[]
  err = .string[]
  inner_cmd = "TERM= THE_HOME_DIR=" || shell_quote(the_home) || " " || shell_quote(the_bin)
  inner_cmd = inner_cmd || " -b -q -p " || shell_quote(profile_path) || " " || shell_quote(source_path)
  shell_lines = .string[]
  shell_lines[1] = inner_cmd
  address command "sh" input shell_lines output out error err
  the_rc = rc
  call remove_tree temp_dir

  if the_rc <> 0 then do
    call diagnostic_message "render-html.crexx: THE failed while highlighting example " || id || " with rc " || the_rc
    call write_stem "stderr", err
    return 2
  end

  pmsg_count = 0
  pmsgs = .string[]
  do ei = 1 to err.0
    line = err[ei]
    if left(line, 21) = "THE_BATCH_PMSG_COUNT=" then do
      pmsg_count = substr(line, 22)
    end
    else if left(line, 15) = "THE_BATCH_PMSG=" then do
      call arrayappend pmsgs, substr(line, 16)
    end
    else if left(line, 26) = "THE_BATCH_STYLESPAN_COUNT=" then do
      nop
    end
    else if left(line, 20) = "THE_BATCH_STYLESPAN=" then do
      call arrayappend spans, substr(line, 21)
    end
  end
  do oi = 1 to out.0
    line = out[oi]
    if left(line, 21) = "THE_BATCH_PMSG_COUNT=" then do
      pmsg_count = substr(line, 22)
    end
    else if left(line, 15) = "THE_BATCH_PMSG=" then do
      call arrayappend pmsgs, substr(line, 16)
    end
    else if left(line, 26) = "THE_BATCH_STYLESPAN_COUNT=" then do
      nop
    end
    else if left(line, 20) = "THE_BATCH_STYLESPAN=" then do
      call arrayappend spans, substr(line, 21)
    end
  end

  if pmsg_count > 0 & fail_diag = "true" then do
    call diagnostic_message "render-html.crexx: parser diagnostics present in example " || id
    call write_stem "stderr", pmsgs
    return 1
  end

return 0

highlighted_line: procedure = .string
  arg text = .string, line_no = .int, spans = .string[]

  html = ""
  cell = 0
  text_length = length(text)

  do si = 1 to spans.0
    span = spans[si]
    span_line = word(span, 1)
    if span_line <> line_no then iterate

    start = word(span, 2)
    span_len = word(span, 3)
    style = word(span, 4)
    gap_len = start - cell
    if gap_len > 0 then do
      html = html || html_escape(substr(text, cell + 1, gap_len))
    end

    if span_len > 0 then do
      span_text = substr(text, start + 1, span_len)
      css_class = css_class_for_style(style)
      if css_class = "" then html = html || html_escape(span_text)
      else html = html || '<span class="' || css_class || '">' || html_escape(span_text) || "</span>"
      cell = start + span_len
    end
  end

  rest_len = text_length - cell
  if rest_len > 0 then do
    html = html || html_escape(substr(text, cell + 1, rest_len))
  end

return html

css_class_for_style: procedure = .string
  arg style = .string
  if style = "comment" then return "syn-comment"
  if style = "string" then return "syn-string"
  if style = "number" then return "syn-number"
  if style = "keyword" then return "syn-keyword"
  if style = "preprocessor" then return "syn-preprocessor"
  if style = "type" then return "syn-type"
  if style = "function" then return "syn-function"
  if style = "constant" then return "syn-constant"
  if style = "identifier" then return "syn-identifier"
  if style = "operator" then return "syn-operator"
  if style = "punctuation" then return "syn-punctuation"
  if style = "paren" then return "syn-paren"
return ""

manifest_value: procedure = .string
  arg record = .string, key = .string
  needle = key || "="
  start = pos(needle, record)
  if start = 0 then return ""
  start = start + length(needle)
  finish = pos(" ", record, start)
  if finish = 0 then return substr(record, start)
return substr(record, start, finish - start)

html_escape_attr: procedure = .string
  arg text = .string
return html_escape(text)

html_escape: procedure = .string
  arg text = .string
  out = ""
  do hi = 1 to length(text)
    ch = substr(text, hi, 1)
    select
      when ch = "&" then out = out || "&amp;"
      when ch = "<" then out = out || "&lt;"
      when ch = ">" then out = out || "&gt;"
      when ch = '"' then out = out || "&quot;"
      otherwise out = out || ch
    end
  end
return out

write_lines_to_file: procedure = .int
  arg path = .string, lines = .string[]
  if lines.0 = 0 then return create_empty_file(path)
  do wi = 1 to lines.0
    write_rc = lineout(path, lines[wi])
    if write_rc <> 0 then return 1
  end
  call lineout(path)
return 0

create_empty_file: procedure = .int
  arg path = .string
  fid = 0
  mode = "w"
  assembler fopen fid,path,mode
  if fid = 0 then return 1
  close_rc = 0
  assembler fclose close_rc,fid
  if close_rc <> 0 then return 1
return 0

write_stem: procedure
  arg target = .string, values = .string[]
  do wi = 1 to values.0
    call lineout target, values[wi]
  end
return

remove_tree: procedure
  arg path = .string
  if path = "" then return
  remove_cmd = "rm -rf " || shell_quote(path)
  address command remove_cmd
return

extension_for_language: procedure = .string
  arg language = .string
  if language = "rxc" then return "rexx"
  if language = "rexx" then return "rexx"
  if language = "crexx" then return "crexx"
  if language = "the" then return "the"
  if language = "mdp" then return "md"
return language

shell_quote: procedure = .string
  arg value = .string
  quoted = "'"
  do qi = 1 to length(value)
    ch = substr(value, qi, 1)
    if ch = "'" then quoted = quoted || "'""'""'"
    else quoted = quoted || ch
  end
return quoted || "'"

rexx_single_quote: procedure = .string
  arg value = .string
  quoted = "'"
  do qi = 1 to length(value)
    ch = substr(value, qi, 1)
    if ch = "'" then quoted = quoted || "''"
    else quoted = quoted || ch
  end
return quoted || "'"

opening_fence: procedure = .string
  arg line = .string
  idx = first_nonblankish(line)
  if idx = 0 | idx > 4 then return ""
  ch = substr(line, idx, 1)
  if ch <> "`" & ch <> "~" then return ""
  count = 0
  do while idx + count <= length(line)
    if substr(line, idx + count, 1) <> ch then leave
    count = count + 1
  end
  if count < 3 then return ""
return substr(line, idx, count)

closing_fence: procedure = .int
  arg line = .string, opener = .string
  idx = first_nonblankish(line)
  if idx = 0 | idx > 4 then return 0
  ch = substr(opener, 1, 1)
  if substr(line, idx, 1) <> ch then return 0
  count = 0
  do while idx + count <= length(line)
    if substr(line, idx + count, 1) <> ch then leave
    count = count + 1
  end
  if count < length(opener) then return 0
  rest = substr(line, idx + count)
  if strip(rest) = "" then return 1
return 0

fence_info: procedure = .string
  arg line = .string, fence = .string
  idx = first_nonblankish(line)
  if idx = 0 then return ""
return substr(line, idx + length(fence))

first_nonblankish: procedure = .int
  arg line = .string
  do idx = 1 to length(line)
    ch = substr(line, idx, 1)
    if ch <> " " & ch <> '09'x then return idx
  end
return 0

is_example_language: procedure = .int
  arg language = .string
  if language = "rexx" | language = "crexx" | language = "the" then return 1
return 0

is_allowed_attribute: procedure = .int
  arg key = .string
  if key = "id" then return 1
  if key = "run" then return 1
  if key = "kind" then return 1
  if key = "output" then return 1
  if key = "expect" then return 1
  if key = "timeout" then return 1
  if key = "allow-rc" then return 1
  if key = "fail-on-diagnostics" then return 1
return 0

valid_identifier: procedure = .int
  arg value = .string
  if value = "" then return 0
  first = substr(value, 1, 1)
  if pos(first, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz") = 0 then return 0
  allowed = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_.-"
  do idx = 2 to length(value)
    if pos(substr(value, idx, 1), allowed) = 0 then return 0
  end
return 1

positive_integer: procedure = .int
  arg value = .string
  if value = "" then return 0
  if verify(value, "0123456789") <> 0 then return 0
  if value <= 0 then return 0
return 1

non_negative_integer: procedure = .int
  arg value = .string
  if value = "" then return 0
  if verify(value, "0123456789") <> 0 then return 0
return 1

string_array_index: procedure = .int
  arg values = .string[], wanted = .string
  do idx = 1 to values.0
    if values[idx] = wanted then return idx
  end
return 0

starts_with: procedure = .int
  arg value = .string, prefix = .string
  if length(value) < length(prefix) then return 0
  if left(value, length(prefix)) = prefix then return 1
return 0

tokenize_info: procedure = .int
  arg text = .string, expose tokens = .string[]
  current = ""
  quote = ""
  do idx = 1 to length(text)
    ch = substr(text, idx, 1)
    if quote <> "" then do
      if ch = quote then quote = ""
      else current = current || ch
    end
    else do
      if ch = '"' | ch = "'" then quote = ch
      else if ch = " " | ch = '09'x then do
        if current <> "" then do
          call arrayappend tokens, current
          current = ""
        end
      end
      else current = current || ch
    end
  end
  if quote <> "" then return -1
  if current <> "" then call arrayappend tokens, current
return tokens.0
