'SET UTF8 TERMINAL CLASS text-variation CURSORSTRATEGY line'
'SET UTF8 TERMINAL CLASS text-variation REPLACESTRATEGY line'

'SET UTF8 TERMINAL CLASS emoji-variation LAYOUT 2 CURSOR 2'
