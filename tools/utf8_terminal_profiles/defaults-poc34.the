'SET UTF8 TERMINAL CLASS emoji-variation REPLACESTRATEGY line'

'SET UTF8 TERMINAL CLASS modifier LAYOUT 2 CURSOR 2'
'SET UTF8 TERMINAL CLASS modifier CURSORSTRATEGY line'
'SET UTF8 TERMINAL CLASS modifier REPLACESTRATEGY line'

'SET UTF8 TERMINAL CLASS keycap LAYOUT 2 CURSOR 2'
'SET UTF8 TERMINAL CLASS keycap CURSORSTRATEGY clear_from_first_cluster_fast'
'SET UTF8 TERMINAL CLASS keycap REPLACESTRATEGY clear_whole_fast'

'SET UTF8 TERMINAL CLASS regional-flag LAYOUT 3 CURSOR 3'
'SET UTF8 TERMINAL CLASS regional-flag CURSORSTRATEGY changed_cells'
'SET UTF8 TERMINAL CLASS regional-flag REPLACESTRATEGY clear_changed_suffix_fast'

