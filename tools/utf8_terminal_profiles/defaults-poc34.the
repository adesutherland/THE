/* THE UTF-8 terminal coded defaults. */
/* Source: tools/utf8_terminal_probe.c calibration_defaults[]. */
/* Probe: utf8_terminal_probe 2026-05-13-poc34. */
/* Complete table; terminal-specific settings can be applied after this file. */

address the

'SET UTF8 TERMINAL CLASS ascii LAYOUT 1 CURSOR 1'
'SET UTF8 TERMINAL CLASS ascii CURSORSTRATEGY changed_cells'
'SET UTF8 TERMINAL CLASS ascii REPLACESTRATEGY changed_cells'

'SET UTF8 TERMINAL CLASS combining LAYOUT 1 CURSOR 1'
'SET UTF8 TERMINAL CLASS combining CURSORSTRATEGY line'
'SET UTF8 TERMINAL CLASS combining REPLACESTRATEGY line'

'SET UTF8 TERMINAL CLASS combining-stack LAYOUT 1 CURSOR 1'
'SET UTF8 TERMINAL CLASS combining-stack CURSORSTRATEGY line'
'SET UTF8 TERMINAL CLASS combining-stack REPLACESTRATEGY line'

'SET UTF8 TERMINAL CLASS wide LAYOUT 2 CURSOR 2'
'SET UTF8 TERMINAL CLASS wide CURSORSTRATEGY changed_cells'
'SET UTF8 TERMINAL CLASS wide REPLACESTRATEGY changed_cells'

'SET UTF8 TERMINAL CLASS ambiguous LAYOUT 1 CURSOR 1'
'SET UTF8 TERMINAL CLASS ambiguous CURSORSTRATEGY changed_cells'
'SET UTF8 TERMINAL CLASS ambiguous REPLACESTRATEGY changed_cells'

'SET UTF8 TERMINAL CLASS emoji LAYOUT 2 CURSOR 2'
'SET UTF8 TERMINAL CLASS emoji CURSORSTRATEGY line'
'SET UTF8 TERMINAL CLASS emoji REPLACESTRATEGY line'

